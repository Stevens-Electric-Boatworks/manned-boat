<Group SymbolName="BestPerformanceCurveSpeed"><Parameter SymbolName="LastSubIndex" Index="0x2140" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Speed" Index="0x2140" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        <table id="ET">
          <tr id="ETHead"> <th>Sub index</th> <th>Name</th>               <th>Description</th></tr>
          <tr id="ETRow">  <td>1</td>         <td>BPC Speed 1</td>        <td id="ETData">Must be smaller than speed 2.</td></tr>
          <tr id="ETRow">  <td>2</td>         <td>BPC Speed 2</td>        <td id="ETData">Must be larger than speed 1 and smaller than 3.</td></tr>
          <tr id="ETRow">  <td>3</td>         <td>BPC Speed 3</td>        <td id="ETData">Must be larger than speed 2 and smaller than 4.</td></tr>
          <tr id="ETRow">  <td>4</td>         <td>BPC Speed 4</td>        <td id="ETData">Must be larger than speed 3 and smaller than 5.</td></tr>
