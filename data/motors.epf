        <Event Name="3V3Low" EventId="1702u" CheckIn4Khz="FALSE" StoreInLog="TRUE" StoreFreezeFrame="TRUE">
      <Description><![CDATA[
        
        <b>Description</b><br/>
        Internal 3.3V supply too low. Limit 2.9V. Uses MCU internal PVD (Programmable Voltage Detection).
        A flag is set by MCU hardware and event is set when VDD is below the limit and cleared if above.
        Hysteresis is 100mV<br/>
        <b>When is event evaluated</b><br/>
        Always<br/>
        <b>Related parameters</b><br/>
        No related parameters.
        
      ]]></Description>
      <EmcyCode Value="0x3302u"/>
      <DtcCode Value="0x7E7141Fu"/>
     <ReductionFactor Value="0"/>
      <ErrorBit Value="17u"/>
