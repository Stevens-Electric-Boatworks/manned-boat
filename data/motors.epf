<Group SymbolName="DigitalInStatus"><Parameter SymbolName="LastSubIndex" Index="0x2350" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="15" Factor="1" Unit="-"><Description><![CDATA[
       
       Number of digital in pins.
       
     ]]></Description></Parameter><Parameter SymbolName="Status1" Index="0x2350" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_1]]></Description></Parameter><Parameter SymbolName="Status2" Index="0x2350" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_2]]></Description></Parameter><Parameter SymbolName="Status3" Index="0x2350" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_3]]></Description></Parameter><Parameter SymbolName="Status4" Index="0x2350" SubIndex="4" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_4]]></Description></Parameter><Parameter SymbolName="Status5" Index="0x2350" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_5 (ACS_ID_1)]]></Description></Parameter><Parameter SymbolName="Status6" Index="0x2350" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_6 (ACS_ID_2)]]></Description></Parameter><Parameter SymbolName="Status7" Index="0x2350" SubIndex="7" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_7]]></Description></Parameter><Parameter SymbolName="Status8" Index="0x2350" SubIndex="8" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_8]]></Description></Parameter><Parameter SymbolName="Status9" Index="0x2350" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_9]]></Description></Parameter><Parameter SymbolName="Status10" Index="0x2350" SubIndex="10" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[ENCODER_IN_2A]]></Description></Parameter><Parameter SymbolName="Status11" Index="0x2350" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[ENCODER_IN_2B]]></Description></Parameter><Parameter SymbolName="Status13" Index="0x2350" SubIndex="12" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[DIGITAL_IN_13]]></Description></Parameter><Parameter SymbolName="Status14" Index="0x2350" SubIndex="13" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[ENCODER_IN_1C]]></Description></Parameter><Parameter SymbolName="Status15" Index="0x2350" SubIndex="14" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[ENCODER_IN_1A]]></Description></Parameter><Parameter SymbolName="Status16" Index="0x2350" SubIndex="15" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="15U" Factor="1" Unit="-"><Description><![CDATA[ENCODER_IN_1B]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputVoltage"><Parameter SymbolName="LastSubIndex" Index="0x2470" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Number of open-drain voltage measurements.
       
      ]]></Description></Parameter><Parameter SymbolName="Voltage" Index="0x2470" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        Voltage at Open Drain Output 1..N.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputFilteredVoltage"><Parameter SymbolName="LastSubIndex" Index="0x2471" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Number of open-drain voltage measurements.
       
      ]]></Description></Parameter><Parameter SymbolName="FilteredVoltage" Index="0x2471" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        Filtered Voltage at Open Drain Output 1..N.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputPeriod"><Parameter SymbolName="LastSubIndex" Index="0x2480" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Period" Index="0x2480" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Timer Period for Open Drain Output 1..N (The timers ARR-value). It is dependent on the switching frequency and timer frequency used on the output channel. </br>
        Period Calculation:  </br>
        TIM1 and TIM3:  (Divided by 2 as center-aligned mode is chosen )  </br>
          Period = ((TIM1_FREQUENCY / Frequency_U16) / 2u) </br>
          Period = ((TIM3_FREQUENCY / Frequency_U16) / 2u) </br>
        TIM9: (TIM9 uses edge-aligned mode) </br>
          Period = TIM9_FREQUENCY / Frequency_U16 </br>
        where, </br>
          TIM1_FREQUENCY : ((((((U32)200*1000000UL) )/2UL)  *2UL)/(2uL))   </br>
          TIM3_FREQUENCY : ((((((U32)200*1000000UL) )/4UL)  *2UL)/(1uL))   </br>
          TIM9_FREQUENCY : ((((((U32)200*1000000UL) )/2UL)  *2UL)/(2uL))   </br>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="HighSide"><Parameter SymbolName="LastSubIndex" Index="0x2491" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="HighSideSwitchControl" Index="0x2491" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        <ul>
        <li>1 = Turn High Side Switch on</li>
        <li>0 = Turn High Side Switch off</li>
        </ul><br/>
        If High Side Switch has tripped due to a short circuit, for example, the High Side Switch has to be disabled
        and re-enabled to be activated again after the fault condition has been removed.
       
      ]]></Description></Parameter><Parameter SymbolName="HighSideSwitchStatus" Index="0x2491" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        <ul>
        <li>1 = High Side Switch is on</li>
        <li>0 = High Side Switch is off</li>
        </ul><br/>
        This show the actual status of the High Side Switch. If the High Side Switch has tripped due to a short circuit,
        for example, the High Side Switch has to be disabled and re-enabled to be activated again after the fault condition has been removed.
       
      ]]></Description></Parameter><Parameter SymbolName="HighSideOutVoltage" Index="0x2491" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        High Side Out voltage level.
       
      ]]></Description></Parameter><Parameter SymbolName="HighSideOutCurrent" Index="0x2491" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="mA"><Description><![CDATA[
       
        High Side Output current level, calculated as the sum of the current on the open drain outputs connected to it. <br/>
        See OpenDrainsOnHighSide for info about which open drain outputs that are connected.
       
      ]]></Description></Parameter><Parameter SymbolName="HighSidePeakCurrentLevel" Index="0x2491" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="6600u  " DefaultValue="6000" Factor="1" Unit="mA"><Description><![CDATA[
       
        Peak current limit level for High Side Output. <br/>
        If high side current is above this level for 16ms the HighSideHighPeakCurr event will be set. <br/>
        If set to 0 the hardware limit will apply.
       
      ]]></Description></Parameter><Parameter SymbolName="HighSideOverloadCurrentLevel" Index="0x2491" SubIndex="12" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="4400u  " DefaultValue="4000" Factor="1" Unit="mA"><Description><![CDATA[
       
        Overload current limit level for High Side Output. <br/>
        If high side current is above this level for 10s the HighSideOverload event will be set. <br/>
        If set to 0 the hardware limit will apply.
       
      ]]></Description></Parameter><Parameter SymbolName="OpenDrainsOnHighSide" Index="0x2491" SubIndex="13" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65355" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Open Drain outputs connected to High Side Out bitfield.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="IndependentSupervision"><Parameter SymbolName="LastSubIndex" Index="0x2500" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="OverSpeedLimitForward" Index="0x2500" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="4500" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Limit for when indepedent supervision module will set high speed event.
       
      ]]></Description></Parameter><Parameter SymbolName="OverSpeedLimitReverse" Index="0x2500" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="0" DefaultValue="-4500" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Limit for when indepedent supervision module will set high speed event.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentSpeedLimitForward" Index="0x2500" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       The limit that is used at this moment. If this limit is smaller than OverSpeedLimitForward there is either a Forced Braking in effect or a tempary speed limit has been set.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentSpeedLimitReverse" Index="0x2500" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       The limit that is used at this moment. If this limit is smaller than OverSpeedLimitReverse there is either a Forced Braking in effect or a tempary speed limit has been set.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentControlCurrentLimit" Index="0x2500" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" DefaultValue="0" Factor="1" Unit="%"><Description><![CDATA[
       
       Defines the level, in percentage of <a href="#ApplicationSwInformation.HwDetectedMaxCurrent">HwDetectedMaxCurrent</a>,
       that the difference between the reference current (<a href="#TorqueReferenceManager.CurrentReference">CurrentReference</a>)
       and the measured current (<a href="#MotorMeasurements.RmsMotorCurrent">RmsMotorCurrent</a>)
       needs to be above in order to detect ACCurrentControlError-event. <br/>
       Setting this parameter to Zero will turn off detection of ACCurrentControlError-event.<br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentControlUpeakLimit" Index="0x2500" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" DefaultValue="75" Factor="1" Unit="%"><Description><![CDATA[
       
       Defines the level, in percentage of <a href="#MotorVoltageControl.UPeakLimit">UPeakLimit</a>,
       that <a href="#MotorVoltageControl.UPeakNormalized">UPeakNormalized</a> needs to be below in order to
       detect ACCurrentControlError-event. <br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentControlDcVoltageLimit" Index="0x2500" SubIndex="7" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" DefaultValue="25" Factor="1" Unit="%"><Description><![CDATA[
       
       Defines the level, in percentage of <a href="#DcBus.NominalVoltage">NominalVoltage</a>,
       that <a href="#DcBus.FilteredVoltage">FilteredVoltage</a> needs to be above in order to
       detect ACCurrentControlError-event. <br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentMeasSpeedLimit" Index="0x2500" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Defines the speed limit used in ACCurrentMeasPlausibilityError-event detection.<br/>
       Setting this parameter to Zero will turn off detection of ACCurrentMeasPlausibilityError-event.<br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentMeasCurrentLimit" Index="0x2500" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" DefaultValue="3" Factor="1" Unit="%"><Description><![CDATA[
       
       Defines the level, in percentage of <a href="#ApplicationSwInformation.HwDetectedMaxCurrent">HwDetectedMaxCurrent</a>,
       that <a href="#MotorMeasurements.RmsMotorCurrent">RmsMotorCurrent</a> needs to be below in order to
       detect ACCurrentMeasPlausibilityError-event. <br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentMeasUpeakLimit" Index="0x2500" SubIndex="10" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" DefaultValue="3" Factor="1" Unit="%"><Description><![CDATA[
       
       Defines the level, in percentage of <a href="#MotorVoltageControl.UPeakLimit">UPeakLimit</a>,
       that <a href="#MotorVoltageControl.UPeakNormalized">UPeakNormalized</a> needs to be above in order to
       detect ACCurrentMeasPlausibilityError-event. <br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="ACCurrentMeasDcVoltageLimit" Index="0x2500" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" DefaultValue="25" Factor="1" Unit="%"><Description><![CDATA[
       
       Defines the level, in percentage of <a href="#DcBus.NominalVoltage">NominalVoltage</a>,
       that <a href="#DcBus.FilteredVoltage">FilteredVoltage</a> needs to be above in order to
       detect ACCurrentMeasPlausibilityError-event. <br/>
       See event description for more information regarding event.
       
      ]]></Description></Parameter><Parameter SymbolName="TestMode" Index="0x2500" SubIndex="12" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       For testability, set to 1 to set special test mode. In special test mode the events ACCurrentControlError and ACCurrentMeasPlausibilityError
       will be evaluated even if DisableCurrentControl is set to 1.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="DCVoltageControl"><Description><![CDATA[
     
      <div>
      To get the structual view of how the dc control works look in dokuwiki (sw/knowledgebase/plasma3):
      <p><a href="http://sthsv11/dokuwiki/doku.php?id=sw:plsw_knowledgebase:plasma_3:dcvoltagecontrol">DC voltage control structure</a><p>
      <div>
     
    ]]></Description><Parameter SymbolName="LastSubIndex" Index="0x2640" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PGain" Index="0x2640" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="200" Factor="1" Unit="-"><Description><![CDATA[
       
        Proportional gain of the PID-controller.
       
      ]]></Description></Parameter><Parameter SymbolName="IGain" Index="0x2640" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="10" Factor="1" Unit="-"><Description><![CDATA[
       
        Intergral gain of the PID-controller.
       
      ]]></Description></Parameter><Parameter SymbolName="DGain" Index="0x2640" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="200" Factor="1" Unit="-"><Description><![CDATA[
       
        Derivative gain of the PID-controller. The <a href="#DCVoltageControl.VoltageError">VoltageError</a> is high pass filtered
        with the <a href="#DCVoltageControl.DErrorFilterGain">DErrorFilterGain</a> then multiplied with
        <a href="#DCVoltageControl.DGainSpeedComp">DGainSpeedComp</a>.
        The result is <a href="#DCVoltageControl.DPart">DPart</a> which is one part of the total output (<a href="#DCVoltageControl.DcControllerOutput">DcControllerOutput</a>).
       
      ]]></Description></Parameter><Parameter SymbolName="PIErrorFilterGain" Index="0x2640" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="16384" Factor="1" Unit="-"><Description><![CDATA[
       
        The filter gain for low pass filtering of the voltage error input to the PI-controller. </br></br>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) </br>
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="DErrorFilterGain" Index="0x2640" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="2000" Factor="1" Unit="-"><Description><![CDATA[
       
        The filter gain for high pass filtering of the <a href="#DCVoltageControl.VoltageError">VoltageError</a> used to created the
        <a href="#DCVoltageControl.DPart">DPart</a>. <br/></br>
        FilteredValue = RawValue - (FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue)) </br>
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="VoltageError" Index="0x2640" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        Voltage error created as measured dc voltage minus <a href="#DCVoltageControl.CommandVoltageRamped">CommandVoltageRamped</a>
       
      ]]></Description></Parameter><Parameter SymbolName="PPart" Index="0x2640" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Proportional part of the PI-regulator.
       
      ]]></Description></Parameter><Parameter SymbolName="IPart" Index="0x2640" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Integrational part of the PI-regulator.
       
      ]]></Description></Parameter><Parameter SymbolName="DPart" Index="0x2640" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        The ActualVoltage minus FiltedVoltage.<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCommandVoltageChange" Index="0x2640" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Specifies the maximum allowed ramp on Command voltage. If a bigger
        step is requested it will work like a ramp until requested value has
        been reached. <br/>
        Setting this parameter to Zero disables ramping.<br/><br/>
        The value is scaled like this, 1 max voltage change means: <br/>
        ((1 * 2^7 / (10 * 2^16))*4000Hz)= 0,78V/s
       
      ]]></Description></Parameter><Parameter SymbolName="CommandVoltageRamped" Index="0x2640" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        <a href="#ApplicationCommands.CommandVoltage">ApplicationCommands, CommandVoltage</a> ramped with
        <a href="#DCVoltageControl.MaxCommandVoltageChange">MaxCommandVoltageChange</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="OutputReductionSpeedLimit" Index="0x2640" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="1200" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        When the absolute value of the speed is above this value all controller gains are compensated (reduced) to
        keep constant gain from dc voltage error to output torque. <br/>
        Setting this parameter to Zero disables reduction.<br/>
        Compensated gains are calculated as: <br/>
        <ul>
        CompensatedGain = UncompensatedGain * OutputReductionSpeedLimit / ActualSpeed
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="PGainSpeedComp" Index="0x2640" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Speed compensated <a href="#DCVoltageControl.PGain">PGain</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="IGainSpeedComp" Index="0x2640" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Speed compensated <a href="#DCVoltageControl.IGain">IGain</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="DGainSpeedComp" Index="0x2640" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Speed compensated <a href="#DCVoltageControl.DGain">DGain</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="DCVoltageControlOutput" Index="0x2640" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
        Output from DC voltage controller.
        The DC voltage control output is the sum of Ppart, Ipart and Dpart.  </br>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="TransientRecorder"><Parameter SymbolName="LastSubIndex" Index="0x2800" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="LogWithPeriod" Index="0x2800" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
       <p>Period with which interval selected variables will be logged.</p>
       When writing to this subindex logging starts.
       When logging is finished value will return to 0.
       All 8kwords of logged data will be stored in RAM as S16.
       Data will be interleaved, if 3 variables are logged, each consecutive sample from each
       channel will be found at every 3:rd position in RAM. <br/><br/>
       T = LogWithPeriod * 250us
       
      ]]></Description></Parameter><Parameter SymbolName="Index0" Index="0x2800" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Index of first variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Subindex0" Index="0x2800" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Subindex of first variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Index1" Index="0x2800" SubIndex="4" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Index of second variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Subindex1" Index="0x2800" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Subindex of second variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Index2" Index="0x2800" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Index of third variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Subindex2" Index="0x2800" SubIndex="7" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Subindex of third variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Index3" Index="0x2800" SubIndex="8" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Index of forth variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="Subindex3" Index="0x2800" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Subindex of forth variable that should be logged. If 0 or invalid no data will be logged
       for this channel.
       
      ]]></Description></Parameter><Parameter SymbolName="TransientRecorderLength" Index="0x2800" SubIndex="33" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Length of data stored in RAM using the transient recorder.
       
      ]]></Description></Parameter><Parameter SymbolName="TransientRecorderStartAddress" Index="0x2800" SubIndex="34" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Startaddress for data stored in RAM using the transient recorder.
       
      ]]></Description></Parameter><Parameter SymbolName="LogFrequency" Index="0x2800" SubIndex="36" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="4000" DefaultValue="0" Factor="1" Unit="Hz"><Description><![CDATA[
       
       Shows the logging frequency that was used at last transient recorder. The
       value is calculated by taking 4000Hz/LogWithPeriod.
       
      ]]></Description></Parameter><Parameter SymbolName="TriggerMode" Index="0x2800" SubIndex="37" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="6" DefaultValue="0"><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Normal"/>
        <ValueFieldDef Value="1" Description="Greater Than"/>
        <ValueFieldDef Value="2" Description="Less Than"/>
        <ValueFieldDef Value="3" Description="Equal To"/>
        <ValueFieldDef Value="4" Description="Internal Trigger"/>
        <ValueFieldDef Value="5" Description="External Trigger"/>
        <ValueFieldDef Value="6" Description="Change in ErrorBitField"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="TriggerValue" Index="0x2800" SubIndex="38" ObjectType="VAR" DataType="INTEGER32" Visibility="Internal" AccessType="rw" MinimumValue="-32768" MaximumValue="65535" DefaultValue="0"><Description><![CDATA[
       
        This is the value that first value of the sampled values should be compared against. If this TriggerValue
        is greater than 32767 it will treat the sampled value as an unsigned 16-bit integer else it will be treated
        as a signed 16-bit integer.
       
      ]]></Description></Parameter><Parameter SymbolName="TriggerValueIsUnsigned" Index="0x2800" SubIndex="39" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0"><Description><![CDATA[
       
        Set this to 1 to indiciate that the TriggerValue should be treated as an unsigned value.
       
      ]]></Description></Parameter><Parameter SymbolName="TriggerDelay" Index="0x2800" SubIndex="40" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Internal" AccessType="rw" MinimumValue="" MaximumValue="" DefaultValue="200"><Description><![CDATA[
       
        This is the delay in number of samples from the trigger event until sampling stops in the transient recorder.
       
      ]]></Description></Parameter><Parameter SymbolName="StoppedAt" Index="0x2800" SubIndex="41" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Internal" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
       
        This is the position where the recording stopped sampling.
       
      ]]></Description></Parameter><Parameter SymbolName="RunAtReset" Index="0x2800" SubIndex="42" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0"><Description><![CDATA[
       
        Set this to 1 to start recording after reset. It will start recording after start-functions are executed.
       
      ]]></Description></Parameter><Parameter SymbolName="LastLogWithPeriod" Index="0x2800" SubIndex="43" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="0"><Description><![CDATA[
       
        Last value written to LogWithPeriod.
       
      ]]></Description></Parameter><Parameter SymbolName="Data" Index="0x2800" SubIndex="45" ObjectType="VAR" DataType="DOMAIN" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Data of transient recorder buffer.
       
      ]]></Description></Parameter><Parameter SymbolName="RecordingOngoing" Index="0x2800" SubIndex="46" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
      
      0 - Transient recorder is not sampling<br/>
      1 - Transient recorder is sampling<br/>
      
      ]]></Description></Parameter></Group>

<Group SymbolName="PowerStageTempLog"><Parameter SymbolName="LastSubIndex" Index="0x2850" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       By writng a 2 to this index the operational data log is cleared.
       
      ]]></Description></Parameter><Parameter SymbolName="PowerStageTempLogData" Index="0x2850" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED32" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="incs"><Description><![CDATA[
       
       <p> Each count tick represents 250 ms and is incremented when drive is enabled.</p>
	   <p> Stored to eeprom every 5 minutes.</p>
       <p>Count for each operational point in interval specified in <a href="#PowerStageTempLogAxis">PowerStageTempLogAxis, PowerStageTempLogAxisValues</a>.</p>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="PowerStageTempLogAxis"><Parameter SymbolName="LastSubIndex" Index="0x2851" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Number intervalls in array.
       
      ]]></Description></Parameter><Parameter SymbolName="PowerStageTempLogAxisValues" Index="0x2851" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="0" Factor="1" Unit="degC"><Description><![CDATA[
       
       <p>Temperature range for data.</p>
       <p>Data range specified in appl_setup.h and is defined at compile time, i.e. stored in flash.</p>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="MotorTempLog"><Parameter SymbolName="LastSubIndex" Index="0x2860" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       By writitng a 2 to this index the operational data log is cleared.
       
      ]]></Description></Parameter><Parameter SymbolName="MotorTempLogData" Index="0x2860" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED32" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="incs"><Description><![CDATA[
       
       <p> Each count tick represents 250 ms and is incremented when drive is enabled.</p>
	   <p> Stored to eeprom every 5 minutes.</p>
       <p>Count for each operational point in interval specified in <a href="#MotorTempLogAxis">MotorTempLogAxis, MotorTempLogAxisValues</a>.</p>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="MotorTempLogAxis"><Parameter SymbolName="LastSubIndex" Index="0x2861" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Number intervalls in array.
       
      ]]></Description></Parameter><Parameter SymbolName="MotorTempLogAxisValues" Index="0x2861" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="0" Factor="1" Unit="degC"><Description><![CDATA[
       
       <p>Temperature range for data.</p>
       <p>Data range specified in appl_setup.h and is defined at compile time, i.e. stored in flash.</p>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OperationDataLog"><Description><![CDATA[
     
      <div>
       The logger consist of <a href="#OperationDataLogSpeedAxis"> the range for speed</a>,
        <a href="#OperationDataLogCurrentAxis"> the range for current</a> and the counter values that ranges from
<a href="#OperationDataLogCurrentAxle0">Axle0</a> .. <a href="#OperationDataLogCurrentAxle10">Axle10</a>.
       <p>Each individual counter represents an operation point with current and speed. The sampler will sample at a fixed rate
and increment the counter that closest represent the operation point in that sample. Note that sampling only takes place when power stage is enabled.</p>
      </div>
     <div>
      <ol>
       <li> For each sample, performed every 250 ms (default),</li>
       <li> one member in the <a href="#OperationDataLogCurrentAxle0">Axle0</a> group is incremented when the current is below the value of <a href="#OperationDataLogCurrentAxis"> current range[0]</a>.</li>
       <ol>
         <li> that is, the value at subindex 0 is incremented if the speed is lower than the value in <a href="#OperationDataLogSpeedAxis"> speed range[0]</a>.</li>
         <li> or the value at subindex 1 is incremented if the speed is also lower than the value in <a href="#OperationDataLogSpeedAxis"> speed range[1]</a>.</li>
         <li> and so on, for the entire speed range.</li>
       </ol>
       <li> or, one member in the <a href="#OperationDataLogCurrentAxle1">Axle1</a> group is incremented when the current is also below the value of <a href="#OperationDataLogCurrentAxis"> current range[1]</a>.</li>
       <ol>
         <li> that is, the value at subindex 0 is incremented if the speed is lower than the value in <a href="#OperationDataLogSpeedAxis"> speed range[0]</a>.</li>
         <li> or the value at subindex 1 is incremented if the speed is also lower than the value in <a href="#OperationDataLogSpeedAxis"> speed range[1]</a>.</li>
         <li> and so on for the entire speed range.</li>
       </ol>
       <li> and so on for the entire current range.</li>
       <li> In each sample only one member is selected, the selected member represent the operating point and is incremented.</li>
       <li> When a counter reaches a value of 4294967296 it will wrap around and start again from zero. With the default sampling rate this will occure after 298261 hours.</li>
      </ol>
     </div>
     
    ]]></Description><Parameter SymbolName="LastSubIndex" Index="0x2900" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="ClearLog" Index="0x2900" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="wo" MinimumValue="0" MaximumValue="2" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Must write 2 to clear log. To avoid clearing by mistake.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OperationDataLogSpeedAxis"><Parameter SymbolName="LastSubIndex" Index="0x2901" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of threshold values.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedAxisValues" Index="0x2901" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Values of speed along the x-axis. These values are constant, based on the configuration during build.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OperationDataLogCurrentAxis"><Parameter SymbolName="LastSubIndex" Index="0x2902" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
