       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter></Group>

<Group SymbolName="FieldWeakeningControl"><Parameter SymbolName="LastSubIndex" Index="0x2075" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="TorqueError" Index="0x2075" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        Input to the PM Field Weakening Controller. It takes the difference
        between ActTorque and RefTorque.
       
      ]]></Description></Parameter><Parameter SymbolName="RegulatorStatus" Index="0x2075" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="3" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Signals if any limiter is active.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Field weakening control not active"/>
        <ValueFieldDef Value="1" Description="Field weakening control active with no limitation"/>
        <ValueFieldDef Value="2" Description="Field weakening control active with current limitation"/>
        <ValueFieldDef Value="3" Description="Field weakening control active with angle limitation"/>
        <ValueFieldDef Value="4" Description="Field weakening control active with slip speed limitation"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="LimitedRefTorque" Index="0x2075" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
        Reference torque limited by over current.
      ]]></Description></Parameter><Parameter SymbolName="IgainVoltageAngle" Index="0x2075" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32766" Factor="1" Unit="-"><Description><![CDATA[
       
        Proportional Gain used to compute Delta Voltage Angle.
       
      ]]></Description></Parameter><Parameter SymbolName="VoltageAngle" Index="0x2075" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Phase angle of the applied motor voltage. <br/><br/>
        Angle = arcsin(ud/sqrt(ud^2+uq^2))<!--<br/><br/>
        32767 = 180 deg <br/>
        -32768 = -180 deg-->
       
      ]]></Description></Parameter><Parameter SymbolName="VoltageAngleIPart" Index="0x2075" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="see Description"><Description><![CDATA[
       
        4kHz increment of the VoltageAngle. Output from the PM Field Weakening Controller <br/>
        32767 = 180 deg <br/>
        -32768 = -180 deg
       
      ]]></Description></Parameter><Parameter SymbolName="PgainVoltageAngle" Index="0x2075" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Proportional Gain used to compute Voltage Angle. <br/>
        value 2^10 => gain = 1.0000
       
      ]]></Description></Parameter><Parameter SymbolName="VoltageAnglePPart" Index="0x2075" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1800" MaximumValue="1799" DefaultValue="0" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Proportional part of the Voltage Angle regulator. <!--<br/>
        32767 = 180 deg <br/>
        -32768 = -180 deg-->
        
      ]]></Description></Parameter><Parameter SymbolName="MaxVoltageAngle" Index="0x2075" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1800" MaximumValue="1799" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Maximum allowed voltage angle. <!--<br/>
        32767 = 180 deg <br/>
        -32768 = -180 deg-->
       
      ]]></Description></Parameter><Parameter SymbolName="UpeakInFieldWeakening" Index="0x2075" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="(18000)" Factor="1"><Description><![CDATA[
        Lower Upeak used in Field Weakening to allow current control hysteresis on modulation level.
      ]]></Description></Parameter><Parameter SymbolName="UpeakSlewRate" Index="0x2075" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="1024" Factor="1"><Description><![CDATA[
        Slew rate used to ramp Upeak from the UpeakLimit used in current control down to the UpeakInFieldWeakening.
      ]]></Description></Parameter><Parameter SymbolName="UpeakLimitRamped" Index="0x2075" SubIndex="17" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
        Upeak normalized after high pass filtering. <br/><br/>
        
      ]]></Description></Parameter></Group>

<Group SymbolName="TorqueCalculation"><Parameter SymbolName="LastSubIndex" Index="0x2076" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="RefTorque" Index="0x2076" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        Reference torque input to the PM Fiels Weakening Controller. It is computed from the RotorFlux and the inductance parameters (0x2076:4-5).</br></br>
        Torque = 3/2*MotorPoles*iq*RotorFlux + id*iq(Ld-Lq)
       
      ]]></Description></Parameter><Parameter SymbolName="ActTorque" Index="0x2076" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        Actual torque input to the PM Fiels Weakening Controller. It is computed from the RotorFlux and the inductance parameters (0x2076:4-5).</br></br>
        Torque = 3/2*MotorPoles*iq*RotorFlux + id*iq(Ld-Lq)
       
      ]]></Description></Parameter><Parameter SymbolName="NominalRotorFlux" Index="0x2076" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1763" Factor="0.1" Unit="mVs"><Description><![CDATA[
       
        Magnetic rotor flux used as pre-load and feed-forward to the current controller.
        It is also used to as a starting value for RotorFluxCalc.
       
      ]]></Description></Parameter><Parameter SymbolName="MoreRefTorqueFactor" Index="0x2076" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        When in field weakening this factor can increase or decrease the max actual current
        by increasing the torque reference to the field weakening regulator. <br/>
        Higher max current will normally mean higher max torque although it can result
        in lower efficiency. <br/>
        No effect in current control mode or if MoreRefTorqueFactor is 0. <br/>
        RefTorqueComp = + RefTorque + (ActualCurrentAngle-ReferenceCurrentAngle) * RefTorque * MoreRefTorqueFactor <br/>
        The scaling of MoreRefTorqueFactor is [Internal torque scaling/internal angle scaling] <br/>
        For induction mashine if more torque is needed in field weakening the commisioning procedure would be to start
        from 0 and increase untill desirable max torque is reached (be careful not to increase max torque to the point were
        torque to current relation gets lower than required). <br/>
        For PM mashine it is more about reaching the max voltage angle. The commisioning procedure would then be to start
        from 0 and increase untill max voltage angle can be reached. <br/>
        The torque to current ratio is always optimal in field weakening for any torque both for IM and PM since we are utilizing the full dc voltage. <br/>
      
      ]]></Description></Parameter><Parameter SymbolName="TorqueFilterShiftSteps" Index="0x2076" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="15" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Filter constant for actual and reference torque filter </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalActTorque" Index="0x2076" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
        
      Separately filtered torque signal . It is computed from the RotorFlux and the inductance parameters (0x2076:4-5).</br></br>
      Torque = 3/2*MotorPoles*iq*RotorFlux + id*iq(Ld-Lq)
      
      ]]></Description></Parameter><Parameter SymbolName="CanSignalTorqueFilterGain" Index="0x2076" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="320" Factor="1" Unit="-"><Description><![CDATA[
        
        First order filtering coefficient for the separately filtered CAN torque signal.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="FluxCalculationMethod" Index="0x2076" SubIndex="20" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2" DefaultValue="CALCULATED_ROTOR_FLUX" Factor="1" Unit="see Description"><Description><![CDATA[
       
        This sets the torque calculation method used.<br/>
        First choise should be alternative 1.<br/>
        <dl>
          <dt>CALCULATED_ROTOR_FLUX:</dt>
            <dd>Inductance table is used if UseTableForInductances = 1 or single parameter is used if UseTableForInductances = 0 (typically for IM).<br/>
            The inductance is used together with RotorFluxCalc.<br/>
            Below MinDeltaStatorAngleForFluxCalc the rotor flux is calculated according to setting of FreezeRotorFluxAtLowSpeed</dd>
          <dt>CALCULATED_DQ_FLUX:</dt>
            <dd>DQ-flux is calculated if above MinDeltaStatorAngleForFluxCalc otherwise taken from DFluxOutput QFluxOutput irms dependent 1D-tables.<br/>
            See DQ-Flux interpolation in appl_setup for commissioning instructions.</dd>
        </dl>
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="CALCULATED_ROTOR_FLUX"/>
        <ValueFieldDef Value="1" Description="CALCULATED_DQ_FLUX"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="DFlux2DTableValue" Index="0x2076" SubIndex="21" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-1764" MaximumValue="1763" DefaultValue="-" Factor="0.1" Unit="mVs"><Description><![CDATA[
        
        Flux in d-direction from id and iq dependent table. </br>
        The table value is based on the actual id and iq currents IdFor2DTableFlux and IqFor2DTableFlux.
       
      ]]></Description></Parameter><Parameter SymbolName="QFlux2DTableValue" Index="0x2076" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-1764" MaximumValue="1763" DefaultValue="-" Factor="0.1" Unit="mVs"><Description><![CDATA[
        
        Flux in q-direction from id and iq dependent table. </br>
        The table value is based on the actual id and iq currents IdFor2DTableFlux and IqFor2DTableFlux.
       
      ]]></Description></Parameter><Parameter SymbolName="IdFor2DTableFlux" Index="0x2076" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Filtered d-current used as input to the actual torque calculation and d-flux from 2D-tables.
       
      ]]></Description></Parameter><Parameter SymbolName="IqFor2DTableFlux" Index="0x2076" SubIndex="24" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Filtered q-current used as input to the actual torque calculation and q-flux from 2D-tables.
       
      ]]></Description></Parameter><Parameter SymbolName="IdFor2DTableFluxFilterShiftSteps" Index="0x2076" SubIndex="25" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        FilterShiftStep for d-current used as input to the actual torque calculation and d-flux from tables. </br>
        For induction motor set to 0. For SRPM set to 4. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="IqFor2DTableFluxFilterShiftSteps" Index="0x2076" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        FilterShiftStep for q-current used as input to the actual torque calculation and q-flux from tables. </br>
        For induction motor set to 0. For SRPM set to 6. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="UseDQfluxTableInFieldWeakening" Index="0x2076" SubIndex="27" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        This sets if the lastRefTorque or DQfluxTable shall be used in fieldweakening. DQFluxTable can only be used if it has been tuned. <br/>
        LastRefTorque = 0, DQfluxTable = 1.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="ActualCurrents"><Parameter SymbolName="LastSubIndex" Index="0x2077" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Iq" Index="0x2077" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Measured instantaneous q-current. Iq is sampled every 0.250 ms (4 kHz).
       
      ]]></Description></Parameter><Parameter SymbolName="Id" Index="0x2077" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Measured instantaneous d-current. Id is sampled every 0.250 msec (4 kHz)
       
      ]]></Description></Parameter><Parameter SymbolName="ActualCurrentAngle" Index="0x2077" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Actual current angle.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleFilterShiftSteps" Index="0x2077" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" Factor="1" Unit="-"><Description><![CDATA[
       
        Time constant for CurrentAngle filter </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter></Group>

<Group SymbolName="ReferenceCurrents"><Parameter SymbolName="LastSubIndex" Index="0x2078" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="IdRef" Index="0x2078" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Reference current in motor d-direction that is input to the current controller.
       
      ]]></Description></Parameter><Parameter SymbolName="IqRef" Index="0x2078" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Reference current in motor q-direction that is input to the current controller.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleOffset" Index="0x2078" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1800" MaximumValue="1799" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        <p>Current Angle Control parameter. Used to determine the current in d and q direction.</p>
        <p>
        Angle = CurrentAngleOffset + CurrentAngleGain * abs(CurrentReference) <br/>
        IdRef = -sin(Angle) * abs(CurrentReference) <br/>
        IqRef = cos(Angle) * CurrentReference
        </p>
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleGain" Index="0x2078" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        <p>Current Angle Control parameter. Used to determine the current in d and q direction.</p>
        <p>
        Angle = CurrentAngleOffset + CurrentAngleGain * abs(CurrentReference) <br/>
        IdRef = -sin(Angle) * abs(CurrentReference) <br/>
        IqRef = cos(Angle) * CurrentReference
        </p>
        <p>To convert from SI-units <i>x</i> in deg/Arms to parameter: <br/>
        CurrentAngleGain = <i>x</i> / 360 * 1638.4
        / &radic;<span style="text-decoration:overline;">2</span> * 1024
        </p>
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAngle" Index="0x2078" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1800" MaximumValue="1799" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Determine the max current angle. <br/>
        The optimal maximum current angle is individual for each motor type.
        The theoretical maximum current angle is 45 degrees. However, due to saturation effects
        the true maximum may be higher. Current angles above 60 degrees are very rare and indicates possible tuning error.
        This parameter is not used when using current angle interpolation arrays.
       
      ]]></Description></Parameter><Parameter SymbolName="IdRefMinimum" Index="0x2078" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-2317" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
        The magnetization current used when low magnitezation current is commanded externaly.
        This parameter is not in use when using PM machines.
        
      ]]></Description></Parameter><Parameter SymbolName="RotorFluxMinimum" Index="0x2078" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1763" Factor="0.1" Unit="mVs"><Description><![CDATA[
       
        IdRef will be internally controlled to achieve this minimum rotor flux. <br/><br/>
        If CalculatedRotorFlux is above RotorFluxMinimum IdRef will not be affected. <br/><br/>
        Set to zero to disable this functionallity.
       
      ]]></Description></Parameter><Parameter SymbolName="ReferenceCurrentAngle" Index="0x2078" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Reference current angle as calculated from reference current, offset and gain.
       
      ]]></Description></Parameter><Parameter SymbolName="ExternalIdRef" Index="0x2078" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        External reference current in motor d-direction that is input to the current controller.
       
      ]]></Description></Parameter><Parameter SymbolName="ExternalIqRef" Index="0x2078" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        External reference current in motor q-direction that is input to the current controller.
       
      ]]></Description></Parameter><Parameter SymbolName="ExternalIdRefActive" Index="0x2078" SubIndex="13" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="-"><Description><![CDATA[
       
          Enable setting of external IdRef.
       
      ]]></Description></Parameter><Parameter SymbolName="ExternalIqRefActive" Index="0x2078" SubIndex="14" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="-"><Description><![CDATA[
       
          Enable setting of external IqRef.
       
      ]]></Description></Parameter><Parameter SymbolName="RotorFluxMinimumControlGain" Index="0x2078" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1"><Description><![CDATA[
       
        Gain that multiply the missing rotor flux to get the additional IdRef current. <br/><br/>
        RotorFluxMinimumControlGain = 256 equals Gain = 1 in the expression below. <br/><br/>
        Additional IdRef = Gain * MAX(0,(MinimumRotorFlux - CalculatedRotorFlux))
       
      ]]></Description></Parameter><Parameter SymbolName="UseRefCurrentAngleTable" Index="0x2078" SubIndex="16" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Selection of reference current angle calculation method. <br/>
        0 = The reference current angle is calculated from CurrentAngleGain and CurrentAngleOffset <br/>
        1 = The reference current angle is calculated from 8 point look-up table<br/>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="MotorVoltageControl"><Parameter SymbolName="LastSubIndex" Index="0x2079" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="UqReference" Index="0x2079" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Reference of the PWM generated motor voltage in the q-direction. Output from the current
        controller.<br/>
        16384 = Udc/&radic;<span style="text-decoration:overline;">2</span> VRMS (hsp) where
        Udc = 36, 48 or 80 V
       
      ]]></Description></Parameter><Parameter SymbolName="UdReference" Index="0x2079" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Reference of the PWM generated motor voltage in the d-direction. Output from the current
        controller.<br/>
        16384 = Udc/&radic;<span style="text-decoration:overline;">2</span> VRMS (hsp) where
        Udc = 36, 48 or 80 V
       
      ]]></Description></Parameter><Parameter SymbolName="UxRefMax" Index="0x2079" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Limit for Ud Reference and Uq Reference.<br/>
        16384 = Udc/&radic;<span style="text-decoration:overline;">2</span> VRMS (hsp) where Udc = 36, 48 or 80 V
       
      ]]></Description></Parameter><Parameter SymbolName="DisableCurrentControl" Index="0x2079" SubIndex="4" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Disables the current control and makes UdRef and UqRef writable. <br/> <br/>
        0 = current control enabled <br/>
        1 = current control disabled
       
      ]]></Description></Parameter><Parameter SymbolName="FieldWeakeningPossible" Index="0x2079" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" Factor="1" Unit="-"><Description><![CDATA[
       
        Parameter that tells if Field Weakening shall be used on this drive.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="No field weakening"/>
        <ValueFieldDef Value="1" Description="Field weakening used"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="IdLimitFactor" Index="0x2079" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Parameter used to compute Id limit for transition from PM Field Weakening
        Control to Current Control. <br/>
        Scaled so that 256 = 1.
       
      ]]></Description></Parameter><Parameter SymbolName="IdLimitOffset" Index="0x2079" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-2317" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Parameter used to compute Id limit for transition from PM Field Weakening.
       
      ]]></Description></Parameter><Parameter SymbolName="UPeakLimit" Index="0x2079" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
       Peak voltage limit for transition from Current Control to PM Field
       Weakening Control and then also used as applied peak voltage. <br/> <br/>
       Given as Modulation Index where 16348 means the maximum
       possible without using over modulation.
       
      ]]></Description></Parameter><Parameter SymbolName="UPeakNormalized" Index="0x2079" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Normalized UPeak used to decide if FieldWeakening shall be enabled or not. <br/>
        Unit: See UPeakLimit
       
      ]]></Description></Parameter><Parameter SymbolName="InFieldWeakeningMode" Index="0x2079" SubIndex="10" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Show that control is in field weakening mode and not current control mode. <br/>
        Note: Will always be 0 when <a href="#ApplicationSetupParameters">ApplicationSetupParameters, ActualControlMode</a> equals Electric Motor Brake Mode.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="In current control mode"/>
        <ValueFieldDef Value="1" Description="In field weakening mode"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="UqRefFiltered" Index="0x2079" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Filtered UqReference.
       
      ]]></Description></Parameter><Parameter SymbolName="UdRefFiltered" Index="0x2079" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Filtered UdReference.
       
      ]]></Description></Parameter><Parameter SymbolName="UdUqFilterShiftSteps" Index="0x2079" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="15" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Time constant for UdFilter and UqFilter. <br/>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="ActualVoltageAngle" Index="0x2079" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Angle for Ud Reference and Uq Reference.<br/>
        <!--16384 = 90 deg,--> Angle increase from zero when only positive Uq voltage and Ud decrease,
       
      ]]></Description></Parameter><Parameter SymbolName="IdLimit" Index="0x2079" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The current level in d-direction shall exceed this value to exit fieldweakening
       
      ]]></Description></Parameter><Parameter SymbolName="UPeakNormalizedFilterShiftSteps" Index="0x2079" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="15" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Time constant for UPeakNormalized filter. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="ActualVoltageAngleFilterShiftSteps" Index="0x2079" SubIndex="17" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="15" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Time constant for ActualVoltageAngle filter. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="IdFiltered" Index="0x2079" SubIndex="18" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Filtered Id current
       
      ]]></Description></Parameter><Parameter SymbolName="IdFilterShiftSteps" Index="0x2079" SubIndex="19" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" Factor="1" Unit="-"><Description><![CDATA[
       
        Time constant for IdFilter
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="MaxNbrOfSamplesAboveIxLimit" Index="0x2079" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        This function works as a leaking bucket mechanism for entering current control. <br/>
        The number of samples that IdFiltered shall be above IdLimit to enter current control. <br/>
        Zero means that the function is disabled.
       
      ]]></Description></Parameter><Parameter SymbolName="TransitionRequired" Index="0x2079" SubIndex="21" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="7" DefaultValue="1" Factor="1" Unit="-"><Description><![CDATA[
        
        Set the required conditions used for transitions from field weakening to current control. <br/>
        The conditions can be fulfilled independent of eachother and are bitmapped:  <br/>
        bit0: IdFiltered above IdLimit <br/>
        bit1: IqFiltered above IqLimit <br/>
        bit2: VoltageAngle not saturated <br/>
        
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="NA"/>
        <ValueFieldDef Value="1" Description="Id above IdLimit fulfilled"/>
        <ValueFieldDef Value="2" Description="Iq above IqLimit fulfilled"/>
        <ValueFieldDef Value="3" Description="Id above IdLimit and Iq above IqLimit fulfilled"/>
        <ValueFieldDef Value="4" Description="VoltageAngle not saturated fulfilled"/>
        <ValueFieldDef Value="5" Description="Id and VoltageAngle not saturated fulfilled"/>
        <ValueFieldDef Value="6" Description="Iq and VoltageAngle not saturated fulfilled"/>
        <ValueFieldDef Value="7" Description="Id, Iq and VoltageAngle not saturated fulfilled"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="IqLimitOffset" Index="0x2079" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-2317" MaximumValue="2316" DefaultValue="5" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Parameter used to compute Iq limit for transition from PM Field Weakening.
       
      ]]></Description></Parameter><Parameter SymbolName="IqLimit" Index="0x2079" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The current level in q-direction shall exceed this value to exit fieldweakening
       
      ]]></Description></Parameter><Parameter SymbolName="IqFiltered" Index="0x2079" SubIndex="24" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Filtered Iq current
       
      ]]></Description></Parameter><Parameter SymbolName="IqFilterShiftSteps" Index="0x2079" SubIndex="25" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="4" Factor="1" Unit="-"><Description><![CDATA[
       
        Time constant for IqFilter
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="TransitionStatus" Index="0x2079" SubIndex="26" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="7" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Show status for the conditions used for transitions from field weakening to current control. <br/>
        The status can be fulfilled independent of eachother and are bitmapped::  <br/>
        bit0: IdFiltered above IdLimit <br/>
        bit1: IqFiltered above IqLimit <br/>
        bit2: VoltageAngle not saturated <br/>
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="NA"/>
        <ValueFieldDef Value="1" Description="Id above IdLimit fulfilled"/>
        <ValueFieldDef Value="2" Description="Iq above IqLimit fulfilled"/>
        <ValueFieldDef Value="3" Description="Id above IdLimit and Iq above IqLimit fulfilled"/>
        <ValueFieldDef Value="4" Description="VoltageAngle not saturated fulfilled"/>
        <ValueFieldDef Value="5" Description="Id and VoltageAngle not saturated fulfilled"/>
        <ValueFieldDef Value="6" Description="Iq and VoltageAngle not saturated fulfilled"/>
        <ValueFieldDef Value="7" Description="Id, Iq and VoltageAngle not saturated fulfilled"/>
      </ValueFieldDefs></Parameter></Group>

<Group SymbolName="CurrentAngleInterpolationInput"><Parameter SymbolName="LastSubIndex" Index="0x207A" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
        
      Nr of curve points in the current angle interpolation table.
     
      ]]></Description></Parameter><Parameter SymbolName="CurrentReference" Index="0x207A" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
        
        Reference point in current for the current angle interpolation.<br/>
        First point must be 0. Each successive point must be > the previous point.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="CurrentAngleInterpolationOutput"><Parameter SymbolName="LastSubIndex" Index="0x207B" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
        
      Nr of curve points in the current angle interpolation table.
     
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleReference" Index="0x207B" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
        
        Reference point in degrees for the equally indexed value in CurrentAngleInterpolationInput.<br/>
        
      ]]></Description></Parameter></Group>

<Group SymbolName="DFluxInterpolationInput"><Parameter SymbolName="LastSubIndex" Index="0x207C" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
        
      Number of curve points in the d and q-flux interpolation tables.
     
      ]]></Description></Parameter><Parameter SymbolName="CurrentInput" Index="0x207C" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
        
        Reference point in current for the d-flux interpolation.<br/>
        First point must be 0. Each successive point must be > the previous point.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="DFluxInterpolationOutput"><Parameter SymbolName="LastSubIndex" Index="0x207D" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
        
      Number of curve points in the d and q-flux interpolation tables.
     
      ]]></Description></Parameter><Parameter SymbolName="DFluxOutput" Index="0x207D" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1764" MaximumValue="1763" DefaultValue="-" Factor="0.1" Unit="mVs"><Description><![CDATA[
        
        Output points for the equally indexed value in DFluxInterpolationInput.
        For PM motors. Notice that you cannot write to DFluxOutput[0] while using 0x2083:1 write option = 1,
        due DFluxOutput[0] is optionally set during 0x2083:2 Temperature coefficient setting.<br/>
        - Read values are defined as for nominal motor temperature 20 C,<br/>
        - 0x2083:1 Write option 0: write values for nominal motor temperature 20 C,<br/>
        - 0x2083:1 Write option 1: write values for the actual current motor temperature.<br/>
        
      ]]></Description></Parameter></Group>

<Group SymbolName="QFluxInterpolationInput"><Parameter SymbolName="LastSubIndex" Index="0x207E" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
        
      Number of curve points in the d and q-flux interpolation tables.
     
      ]]></Description></Parameter><Parameter SymbolName="CurrentInput" Index="0x207E" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
        
        Reference point in current for the q-flux interpolation.<br/>
        First point must be 0. Each successive point must be > the previous point.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="QFluxInterpolationOutput"><Parameter SymbolName="LastSubIndex" Index="0x207F" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="" MaximumValue=""><Description><![CDATA[
        
      Number of curve points in the d and q-flux interpolation tables.
     
      ]]></Description></Parameter><Parameter SymbolName="QFluxOutput" Index="0x207F" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1764" MaximumValue="1763" DefaultValue="-" Factor="0.1" Unit="mVs"><Description><![CDATA[
        
        Output point in mVs for the equally indexed value in QFluxInterpolationInput.<br/>
        
      ]]></Description></Parameter></Group>

