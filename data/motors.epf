     <SteerSystemReaction Value="NO_SYSTEMREACTIONS_BIT"/>
     <OtherSystemReaction Value="NO_SYSTEMREACTIONS_BIT"/>
   <Module Name="Motts"/>
  </Event>
        <Event Name="ShortCircuit" EventId="601u" CheckIn4Khz="FALSE" StoreInLog="TRUE" StoreFreezeFrame="FALSE">
   <Description><![CDATA[
    
     <b>Description</b><br/>
     Event is set if motor temperature sensor is short circuited.<br/>
     SW algorithm: Temperature measurement is out of range.<br/>
     Limits: Event is set when sensor measures -50 deg celsius<br/>
     <i>Note:</i> If the resistance decreases with increasing temperature, such
     as for an NTC sensor, this event signals a not connected sensor instead.<br/>
     <b>When is event evaluated</b><br/>
     Always<br/>
     <b>Related parameters</b><br/>
     <a href="#MotorTemperature">MotorTemperature, Temperature</a><br/>
    
   ]]></Description>
   <EmcyCode Value="0x4220u"/>
   <DtcCode Value="0x7E0641Fu"/>
     <ReductionFactor Value="50"/>
   <ErrorBit Value="31u"/>
   <WarningBit Value="NO_WARNING_BIT"/>
   <PumpSystemReaction Value="STORE_IN_SYSTEM_LOG_BIT"/>
   <TractionSystemReaction Value="STORE_IN_SYSTEM_LOG_BIT;TRACTION_LIMP_HOME_MODE_BIT"/>
   <SteerSystemReaction Value="NO_SYSTEMREACTIONS_BIT"/>
   <OtherSystemReaction Value="STORE_IN_SYSTEM_LOG_BIT"/>
   <Module Name="Motts"/>
  </Event>
        <Event Name="ModeratelyHigh" EventId="602u" CheckIn4Khz="FALSE" StoreInLog="FALSE" StoreFreezeFrame="FALSE">
   <Description><![CDATA[
    
