     <b>Related parameters</b><br/>
     <a href="#MotorTemperature">MotorTemperature, Temperature</a><br/>
     <a href="#MotorTemperature">MotorTemperature, HighLevel</a><br/>
    
   ]]></Description>
   <EmcyCode Value="0x4210u"/>
