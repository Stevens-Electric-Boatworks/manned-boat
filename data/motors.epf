          <tr id="ETRow"> <td>1</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">SubIndex</th>  <th id="ETHead">Value</th>  </tr>
                     <tr id="ETRow"> <td>1</td>  <td id="ETData">60</td></tr>
                     <tr id="ETRow"> <td>2</td>  <td id="ETData">40</td></tr>
                     <tr id="ETRow"> <td>3</td>  <td id="ETData">60</td></tr>
                     <tr id="ETRow"> <td>4</td>  <td id="ETData">90</td></tr>
                    </table>
           </td>
          </tr>
          <tr id="ETRow"> <td>2</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">SubIndex</th>  <th id="ETHead">Value</th>  </tr>
