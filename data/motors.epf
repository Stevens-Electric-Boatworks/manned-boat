MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[PCB Temp]]></Description></Parameter><Parameter SymbolName="MotorTemp1" Index="0x2005" SubIndex="29" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Motor Temp]]></Description></Parameter><Parameter SymbolName="PowerboardTemp1" Index="0x2005" SubIndex="30" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Power Board Temp]]></Description></Parameter><Parameter SymbolName="KeyInputVoltage" Index="0x2005" SubIndex="31" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Key Input Voltage]]></Description></Parameter><Parameter SymbolName="Pos5VC" Index="0x2005" SubIndex="32" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[5V_C Measurement]]></Description></Parameter><Parameter SymbolName="Pos15V" Index="0x2005" SubIndex="33" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[15V Measurement]]></Description></Parameter><Parameter SymbolName="Pos5V" Index="0x2005" SubIndex="34" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[5V Measurement]]></Description></Parameter><Parameter SymbolName="Mux2Gnd2" Index="0x2005" SubIndex="35" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[MUX 2 GND 2]]></Description></Parameter><Parameter SymbolName="OpenDrainOut3Current" Index="0x2005" SubIndex="36" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 3 Current]]></Description></Parameter><Parameter SymbolName="OpenDrainOut4Current" Index="0x2005" SubIndex="37" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 4 Current]]></Description></Parameter><Parameter SymbolName="OpenDrainOut5Current" Index="0x2005" SubIndex="38" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 5 Current]]></Description></Parameter><Parameter SymbolName="OpenDrainOut6Current" Index="0x2005" SubIndex="39" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 6 Current]]></Description></Parameter><Parameter SymbolName="OpenDrainOut1Voltage" Index="0x2005" SubIndex="40" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 1 Voltage]]></Description></Parameter><Parameter SymbolName="OpenDrainOut2Voltage" Index="0x2005" SubIndex="41" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 2 Voltage]]></Description></Parameter><Parameter SymbolName="OpenDrainOut3Voltage" Index="0x2005" SubIndex="42" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Open Drain Out 3 Voltage]]></Description></Parameter><Parameter SymbolName="HighSideOut1Voltage" Index="0x2005" SubIndex="43" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[High Side Out Voltage]]></Description></Parameter><Parameter SymbolName="SensorSupply1Voltage" Index="0x2005" SubIndex="44" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Sensor Supply 1 Voltage]]></Description></Parameter><Parameter SymbolName="SensorSupply2Voltage" Index="0x2005" SubIndex="45" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Sensor Supply 2 Voltage]]></Description></Parameter><Parameter SymbolName="SensorSupply2VoltageOut" Index="0x2005" SubIndex="46" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Sensor Supply 2 Voltage Output]]></Description></Parameter><Parameter SymbolName="Mux4Gnd1" Index="0x2005" SubIndex="47" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[MUX 4 GND]]></Description></Parameter><Parameter SymbolName="SensorSupply1RefVoltage" Index="0x2005" SubIndex="48" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Sensor Supply 1 Ref Voltage]]></Description></Parameter><Parameter SymbolName="SensorSupply2RefVoltage" Index="0x2005" SubIndex="49" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Sensor Supply 2 Ref Voltage]]></Description></Parameter><Parameter SymbolName="SensorSupply1VoltageOut" Index="0x2005" SubIndex="50" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Sensor Supply 1 Voltage Output]]></Description></Parameter><Parameter SymbolName="AnalogIn3Voltage" Index="0x2005" SubIndex="51" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4095" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[Analog In 3 Voltage]]></Description></Parameter></Group>

<Group SymbolName="ADConverterControl" WarningRemark="Internal Use Only"><Parameter SymbolName="LastSubIndex" Index="0x2006" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="AdcWriteEnableLow32" Index="0x2006" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       <p>Writing "1" to bit x, stops update of AD converter value x at the same time as
          it goes into manual mode (i.e. SW stops reading the ADC hardware and ADCx, 2005h:(x+1), is frozen and is only manually controlled by writing to it) , e.g.</p>
       <p>Example: AD Channel Write Enable = 0x8200 stops update of ADC9 and ADC15 values from AD
          converter and will only be possible to change by writing to them manually (pw6 is required).</p>
       <p>Writing "0" to the bit again returns the ADC channel to normal automatic mode.</p>
       <p>Shall ONLY be used for SW verification. Warranty voided if used!</p>
       
     ]]></Description></Parameter><Parameter SymbolName="AdcWriteEnableHigh32" Index="0x2006" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       <p>Writing "1" to bit x, stops update of AD converter value x + 32 at the same time as
          it goes into manual mode (i.e. SW stops reading the ADC hardware and ADCx, 2005h:(x+1+32), is frozen and is only manually controlled by writing to it) , e.g.</p>
       <p>Example: AD Channel Write Enable = 0x8200 stops update of ADC41 and ADC47 values from AD
          converter and will only be possible to change by writing to them manually (pw6 is required).</p>
       <p>Writing "0" to the bit again returns the ADC channel to normal automatic mode.</p>
       <p>Shall ONLY be used for SW verification. Warranty voided if used!</p>
       
     ]]></Description></Parameter></Group>

<Group SymbolName="ApplicationSwInformation"><Parameter SymbolName="LastSubIndex" Index="0x2009" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="HwId" Index="0x2009" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="15" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Up to four bits inputted from external hardware determining the Id of the drive.
       
      ]]></Description></Parameter><Parameter SymbolName="HwDetectedMaxCurrent" Index="0x2009" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="Arms"><Description><![CDATA[
       
             Maximal Drive AC Current determined from Eeprom parameter <a href="#ProductInformation.ItemMaxCurrent">ProductInformation, ItemMaxCurrent</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="SoftwareName" Index="0x2009" SubIndex="4" ObjectType="VAR" DataType="VISIBLE_STRING" Visibility="Operator" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       E.g. "PLASMA"
       
      ]]></Description></Parameter><Parameter SymbolName="EepromPlasmaSegmentCheckSum" Index="0x2009" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       The sum of all Plasma and application parameters checksums. <br/>
       Can be used to check if any parameter in the Eeprom has been changed.
       
      ]]></Description></Parameter><Parameter SymbolName="MCUNumber" Index="0x2009" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Number of the MCU on the board (aka InternalHWID).
       
      ]]></Description></Parameter><Parameter SymbolName="BootConfigurationBits" Index="0x2009" SubIndex="7" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Operator" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Boot configuration bits.
       
      ]]></Description><BitFieldDefs>
        <BitFieldDef Bit="3" Name="UDS supported without security" Description=""/>
        <BitFieldDef Bit="4" Name="UDS supported with security" Description=""/>
      </BitFieldDefs></Parameter><Parameter SymbolName="NumberOfHwIdBits" Index="0x2009" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="4" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Show the number of supported hardware ID-bits.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="ApplicationSetupParameters"><Parameter SymbolName="LastSubIndex" Index="0x2020" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedRampMode" Index="0x2020" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" Factor="1" Unit="-"><Description><![CDATA[
       
       Note: if <a href="#ApplicationSetupParameters.RequestedControlMode">RequestedControlMode</a> equals
       Steer Wheel Mode or Tiller Mode then this setting will be bypassed and speed controller will use no
       ramps (i.e. act a if this parameter is set to Speed Control with No Ramp).
       
     ]]></Description><ValueFieldDefs>
       <ValueFieldDef Value="1" Description="Speed Control with No Ramp"/>
       <ValueFieldDef Value="4" Description="Speed Control with PDO Controlled Ramp"/>
       <ValueFieldDef Value="5" Description="Speed Control with Parameter Controlled ramp"/>
     </ValueFieldDefs></Parameter><Parameter SymbolName="BestPerformanceCurveMode" Index="0x2020" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" Factor="1" Unit="-"><Description><![CDATA[
       
       <ul>
        <li>0 = No BPC Mode</li>
        <li>1 = BPC Mode </li>
        <li>2 = BPC PDO Mode </li>
        <li>3 = BPC Reduction Mode</li>
       </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="RollBackSpeed" Index="0x2020" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Controls if the truck stands still or starts rolling when slowing down to zero
        speed in a slope. RollBackSpeed is max rolling speed in slope. Set RollBack Speed to zero
        for standing (hillhold). The RollBackSpeed value is ramped if it is changed. The rate of
        change is the used ForwardDeceleration value if actual speed is 0 or positive or the used
        ReverseDeceleration value if the actual speed is negative. If any rate of change is zero,
        a value of 1 is used (i.e. always allow a small ramp to reach the rollback speed
        parameter).
        Only used in Speed Control Modes with ramps (Speed Control Mode = 4 or 5).
       
      ]]></Description></Parameter><Parameter SymbolName="ApplicationSetupWord" Index="0x2020" SubIndex="10" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="-"><BitFieldDefs>
           <BitFieldDef Bit="0" Name="Adjust Speed During Acceleration" Description="If set, the truck may accelerate faster than the ramp says, if accelerating in an steep downhill slope."/>
           <BitFieldDef Bit="1" Name="Adjust Speed During Deceleration" Description="If set, the truck may decelerate faster than the ramp says, if decelerating in an steep uphill slope."/>
           <BitFieldDef Bit="2" Name="Enter Rollback Mode At Zero Speed" Description="If set, the truck stops before it eventaully starts to roll. Only used if Rollback Speed is NOT zero"/>
           <BitFieldDef Bit="3" Name="Inverted Rotational Direction" Description="Invert speed, current and torque parameters in ApplicationCommands and ApplicationStatus."/>
           <BitFieldDef Bit="4" Name="Freeze Speed Reference When Saturated" Description="If set, the internal speed reference will freeze while the speed controller is saturated (max current used). This function is only active during acceleration if also Adjust Speed During Acceleration is set and during deceleration if also Adjust Speed During Deceleration is set."/>
           <BitFieldDef Bit="8" Name="Torque Limits Enabled" Description="Set to enable torque limitation via parameters 0x2099:6 - AccTorqueLimit and 0x2099:7 - BrakeTorqueLimit"/>
           <BitFieldDef Bit="9" Name="DC Power Limits Enabled" Description="Set to enable DC power limitation via parameters 2094h:1 - PosDcPowerLimit and 2094h:2 - NegDcPowerLimit"/>
           <BitFieldDef Bit="10" Name="DC Current Limits Enabled" Description="Set to enable DC current limitation via parameters 2094h:3 - PosDcCurrentLimit and 2094h:4 - NegDcCurrentLimit"/>
       <BitFieldDef Bit="15" Name="Product Application Enabled" Description="Set to enable product application. If not set no calls whatsoever will be made to the product application."/>
      </BitFieldDefs><DefaultValue><![CDATA[
        
        <table id="ET">
          <tr id="ETHead"><th id="ETHead">HW-Id</th>  <th id="ETHead">Value</th>  </tr>
          <tr id="ETRow"> <td>0</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">Bit</th>  <th id="ETHead">Value</th>  </tr>
                       <tr id="ETRow"> <td>0</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>1</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>2</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>3</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>4</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>8</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>9</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>10</td> <td id="ETData">0</td></tr>
                     <tr id="ETRow"> <td>15</td>  <td id="ETData">1</td></tr>
                    </table>
           </td>
          </tr>
          <tr id="ETRow"> <td>1</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">Bit</th>  <th id="ETHead">Value</th>  </tr>
                       <tr id="ETRow"> <td>0</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>1</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>2</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>3</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>4</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>8</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>9</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>10</td> <td id="ETData">0</td></tr>
                     <tr id="ETRow"> <td>15</td>  <td id="ETData">1</td></tr>
                    </table>
           </td>
          </tr>
          <tr id="ETRow"> <td>2</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">Bit</th>  <th id="ETHead">Value</th>  </tr>
                       <tr id="ETRow"> <td>0</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>1</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>2</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>3</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>4</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>8</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>9</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>10</td> <td id="ETData">0</td></tr>
                     <tr id="ETRow"> <td>15</td>  <td id="ETData">1</td></tr>
                    </table>
           </td>
         </tr>
          <tr id="ETRow"> <td>3</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">Bit</th>  <th id="ETHead">Value</th>  </tr>
                       <tr id="ETRow"> <td>0</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>1</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>2</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>3</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>4</td>  <td id="ETData">1</td></tr>
                       <tr id="ETRow"> <td>8</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>9</td>  <td id="ETData">0</td></tr>
                       <tr id="ETRow"> <td>10</td> <td id="ETData">0</td></tr>
                     <tr id="ETRow"> <td>15</td>  <td id="ETData">1</td></tr>
                    </table>
           </td>
          </tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter><Parameter SymbolName="MaxCommandSpeed" Index="0x2020" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Sets the absolute limit for the Command Speed.
       
      ]]></Description></Parameter><Parameter SymbolName="RequestedControlMode" Index="0x2020" SubIndex="12" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" Factor="1" Unit="-"><Description><![CDATA[
       
       Depends on the hardware id.<br/><br/>
       <table id="ET">
        <tr id="ETRow"><th>Value</th>
                       <th>Control Mode</th>
                       <th>Description</th></tr>
        <tr id="ETRow"><td>0</td>
                       <td><b>Speed Mode</b></td>
                       <td id="ETData">ActualControlMode equals SpeedMode, speed reference from <a href="#ApplicationCommands">ApplicationCommands, CommandSpeed</a> </td></tr>
        <tr id="ETRow"><td>1</td>
                       <td><b>Steer Wheel Mode</b></td>
                       <td id="ETData">ActualControlMode equals Speed Mode or PositionMode depending on steer wheel input level. <br/>
                       Speed reference equals <a href="#SpeedAndPositionReferenceCalculation">SpeedAndPositionReferenceCalculation, SensorCommandSpeed</a> when ActualControlMode is Speed Mode. <br/>
                       Position reference equals <a href="#ApplicationCommands">ApplicationCommands, CommandPosInSteerWheelMode</a> when ActualControlMode is Position Mode. <br/><br/>
                       In this mode the speed controller will use no ramps no matter the value of <a href="#ApplicationSetupParameters.SpeedRampMode">SpeedRampMode</a>.</td></tr>
        <tr id="ETRow"><td>2</td>
                       <td><b>Tiller Mode</b></td>
                       <td id="ETData">ActualControlMode equals Position Mode. <br/>
                       Position reference equals <a href="#SpeedAndPositionReferenceCalculation">SpeedAndPositionReferenceCalculation, SensorCommandPosition</a> <br/><br/>
                       In this mode the speed controller will use no ramps no matter the value of <a href="#ApplicationSetupParameters.SpeedRampMode">SpeedRampMode</a>. </td></tr>
        <tr id="ETRow"><td>3</td>
                       <td><b>AC Current Mode</b></td>
                       <td id="ETData">ActualControlMode equals AC Current Mode, current reference from <a href="#ApplicationCommands">ApplicationCommands, CommandAcCurrent</a> </td></tr>
        <tr id="ETRow"><td>4</td>
                       <td><b>Position Mode</b></td>
                       <td id="ETData">ActualControlMode equals Position Mode, position reference from <a href="#ApplicationCommands">ApplicationCommands, CommandPosition</a> </td></tr>
        <tr id="ETRow"><td>5</td>
                       <td><b>Torque Mode</b></td>
                       <td id="ETData">ActualControlMode equals Torque Mode, torque reference from <a href="#ApplicationCommands">ApplicationCommands, CommandTorque</a> </td></tr>
        <tr id="ETRow"><td>8</td>
                       <td><b>DC Voltage Mode</b></td>
                       <td id="ETData">ActualControlMode equals DC Voltage Mode, voltage reference from <a href="#ApplicationCommands">ApplicationCommands, CommandVoltage</a> </td></tr>
        <tr id="ETRow"><td>12</td>
                       <td><b>Cranking Mode</b></td>
                       <td id="ETData">ActualControlMode equals Cranking Mode, speed reference from application (API) </td></tr>
        <tr id="ETRow"><td>15</td>
                       <td><b>Electric Motor Brake Mode (PM Only)</b></td>
                       <td id="ETData">ActualControlMode equals Electric Motor Brake Mode, brake torque generated by short circuit of motor phases </td></tr>
       </table>
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Speed Mode"/>
        <ValueFieldDef Value="1" Description="Steer Wheel Mode"/>
        <ValueFieldDef Value="2" Description="Tiller Mode"/>
        <ValueFieldDef Value="3" Description="AC Current Mode"/>
        <ValueFieldDef Value="4" Description="Position Mode"/>
        <ValueFieldDef Value="5" Description="Torque Mode"/>
        <ValueFieldDef Value="8" Description="DC Voltage Mode"/>
        <ValueFieldDef Value="12" Description="Cranking Mode"/>
        <ValueFieldDef Value="15" Description="Electric Motor Brake Mode (PM Only)"/>
        <ValueFieldDef Value="16" Description="Startup Check Mode"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="ActualControlMode" Index="0x2020" SubIndex="13" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="-" Factor="1" Unit="-"><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Speed Mode"/>
        <ValueFieldDef Value="3" Description="AC Current Mode"/>
        <ValueFieldDef Value="4" Description="Position Mode"/>
        <ValueFieldDef Value="5" Description="Torque Mode"/>
        <ValueFieldDef Value="8" Description="DC Voltage Mode"/>
        <ValueFieldDef Value="9" Description="Forced Reverse Mode"/>
        <ValueFieldDef Value="10" Description="After Forced Reverse Mode"/>
        <ValueFieldDef Value="11" Description="Parking Mode"/>
        <ValueFieldDef Value="12" Description="Cranking Mode"/>
        <ValueFieldDef Value="15" Description="Electric Motor Brake Mode (PM Only)"/>
        <ValueFieldDef Value="16" Description="Startup Check Mode"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="MaxCommandPosition" Index="0x2020" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1799" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Sets the maximum allowed command position. <br/>
        Limits only the command position received EXTERNALLY (ex. CANopen or API) or when in
        <a href="#ApplicationSetupParameters.ActualControlMode">ActualControlMode</a> equal to Position Mode (4)
        when <a href="#ApplicationSetupParameters.RequestedControlMode">RequestedControlMode</a> equals Steer Wheel Mode (1). <br/>
        Limitation will be disabled if this parameter or <a href="#ApplicationSetupParameters.MinCommandPosition">MinCommandPosition</a> is set to Zero. <br/>
        This parameter should be zero when <a href="#ApplicationSetupParameters.RequestedControlMode">RequestedControlMode</a> equals Tiller Mode (2).
       
      ]]></Description></Parameter><Parameter SymbolName="MinCommandPosition" Index="0x2020" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-1800" MaximumValue="0" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Sets the minimum allowed command position. <br/>
        Limits only the command position received EXTERNALLY (ex. CANopen or API) or when in
        <a href="#ApplicationSetupParameters.ActualControlMode">ActualControlMode</a> equal to Position Mode (4)
        when <a href="#ApplicationSetupParameters.RequestedControlMode">RequestedControlMode</a> equals Steer Wheel Mode (1). <br/>
        Limitation will be disabled if this parameter or <a href="#ApplicationSetupParameters.MaxCommandPosition">MaxCommandPosition</a> is set to Zero. <br/>
        This parameter should be Zero when <a href="#ApplicationSetupParameters.RequestedControlMode">RequestedControlMode</a> equals Tiller Mode (2).
       
      ]]></Description></Parameter><Parameter SymbolName="SteerWheelModeThreshold" Index="0x2020" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="50" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Threshold on <a href="#SpeedAndPositionReferenceCalculation">SensorCommandSpeed, SensorCommandSpeed</a> for transition between
        <a href="#ApplicationSetupParameters">ActualControlMode</a> Speed Mode (0) and Position Mode (4) when
        <a href="#ApplicationSetupParameters">RequestedControlMode</a> equals Steer Wheel Mode (1).
       
      ]]></Description></Parameter></Group>

<Group SymbolName="ApplicationParameters"><Parameter SymbolName="LastSubIndex" Index="0x2029" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="MasterStatusWord" Index="0x2029" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
     
      Status word received from master controller via CANopen, used in slave mode.
     
    ]]></Description></Parameter><Parameter SymbolName="MasterCurrentRef" Index="0x2029" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-2317" MaximumValue="2316" DefaultValue="0" Factor="1" Unit="Arms"><Description><![CDATA[
     
      Reference current received from master controller via CANopen, used in slave mode.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleErrorState" Index="0x2029" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
     
      State of the throttle error: OK, out of range or failed.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleDirState" Index="0x2029" SubIndex="4" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
     
      Throttle direction state: forward or reverse.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleSignalMilliVolt" Index="0x2029" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="mV"><Description><![CDATA[
     
      Actual throttle value in mV after filter but before exponential modification.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleSignalPercent" Index="0x2029" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="%"><Description><![CDATA[
     
      Actual throttle value converted to a percentage from 0 to APPLMG_ONE_HUNDRED_PERCENT.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleCommandSpeed" Index="0x2029" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
     
      Command speed calculated from the throttle position.
     
    ]]></Description></Parameter><Parameter SymbolName="CurrentMaxCommandSpeed" Index="0x2029" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
     
      Max command speed, either high or low max command speed depending on HighSpeedActive input.
     
    ]]></Description></Parameter><Parameter SymbolName="CANCommandWord" Index="0x2029" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
     
      Command word received from external controller via CANopen.
     
    ]]></Description></Parameter><Parameter SymbolName="CANCommandedSpeed" Index="0x2029" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
     
      Commanded speed received from external controller via CANopen.
     
    ]]></Description></Parameter><Parameter SymbolName="State" Index="0x2029" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
     
      Current application state.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleActiveLowVoltage_mV" Index="0x2029" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="500" Factor="1" Unit="mV"><Description><![CDATA[
     
      Active-low throttle voltage in mV.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleActiveHighVoltage_mV" Index="0x2029" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="4500" Factor="1" Unit="mV"><Description><![CDATA[
     
      Active-high throttle voltage in mV.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleOORLowVoltage_mV" Index="0x2029" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="25" Factor="1" Unit="mV"><Description><![CDATA[
     
      Throttle out-of-range low threshold in mV.
     
    ]]></Description></Parameter><Parameter SymbolName="ThrottleOORHighVoltage_mV" Index="0x2029" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="4950" Factor="1" Unit="mV"><Description><![CDATA[
     
      Throttle out-of-range high threshold in mV.
     
    ]]></Description></Parameter><Parameter SymbolName="HighMaxCommandSpeed" Index="0x2029" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="4000" Factor="1" Unit="-"><Description><![CDATA[
     
      High max command speed used when HighSpeedActive input is inactive.
     
    ]]></Description></Parameter><Parameter SymbolName="LowMaxCommandSpeed" Index="0x2029" SubIndex="17" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="2000" Factor="1" Unit="-"><Description><![CDATA[
     
      Low max command speed used when HighSpeedActive input is active.
     
    ]]></Description></Parameter></Group>

<Group SymbolName="InductanceCalculation"><Parameter SymbolName="LastSubIndex" Index="0x202D" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="EnableAutotuning" Index="0x202D" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="8" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
         AUTO_INDUCTANCE_TUNING     Starts the autotuning procedure.<br/>
         MANUAL_INDUCTANCE_TUNING   Is not available at the moment.<br/>
         WRITE_TABLE                Can be selected when in state "DONE". Writes to platform tables.<br/>
         RESET_INTERNAL_TABLE       Writes values from MotorMeasurements.Ld/Lq to platform tables.<br/>
         CONTINOUS_CALC             Continously calculates Ld/Lq, values are found in ContLd/ContLq params.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="NO_INDUCTANCE_TUNING"/>
        <ValueFieldDef Value="1" Description="AUTO_INDUCTANCE_TUNING"/>
        <ValueFieldDef Value="2" Description="MANUAL_INDUCTANCE_TUNING"/>
        <ValueFieldDef Value="3" Description="DONE"/>
        <ValueFieldDef Value="4" Description="WRITE_TABLE"/>
        <ValueFieldDef Value="5" Description="TABLE_WRITTEN"/>
        <ValueFieldDef Value="6" Description="RESET_INTERNAL_TABLE"/>
        <ValueFieldDef Value="7" Description="CONTINOUS_CALC"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="WaitTime" Index="0x202D" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="8000" DefaultValue="2000" Factor="1" Unit="ms"><Description><![CDATA[
       
         Waiting time after setting new current
       
      ]]></Description></Parameter><Parameter SymbolName="IdCalibration" Index="0x202D" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="500" DefaultValue="-37" Factor="1" Unit="ms"><Description><![CDATA[
       
         Autotuning d-axis current reference
       
      ]]></Description></Parameter><Parameter SymbolName="IqCalibration" Index="0x202D" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="500" DefaultValue="0" Factor="1" Unit="ms"><Description><![CDATA[
       
          Autotuning q-axis current reference
       
      ]]></Description></Parameter><Parameter SymbolName="UseNegativeIq" Index="0x202D" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Used to flip sign of Q-current reference
       
      ]]></Description></Parameter><Parameter SymbolName="ManualStepUp" Index="0x202D" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
         When toggling from 0 to 1, next load step will be performed.
       
      ]]></Description></Parameter><Parameter SymbolName="ManualLq" Index="0x202D" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="3445" DefaultValue="0" Factor="1" Unit="uH"><Description><![CDATA[
        Used to write to Lq in manual tuning.
      ]]></Description></Parameter><Parameter SymbolName="ExternalTorque" Index="0x202D" SubIndex="8" ObjectType="VAR" DataType="INTEGER32" Visibility="Service" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
        
          Externally measured torque.
          Torque in EXTERNAL_TORQUE_REPRESENTATION
        
      ]]></Description></Parameter><Parameter SymbolName="WriteInductancesDirectly" Index="0x202D" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
        
         When set to 1, calculated inductances will be set in the platform table immediately.<br/>
         Otherwise, inductances will be written to a parallel RAM table and written when instructed to.
       
      ]]></Description></Parameter><Parameter SymbolName="ContLd" Index="0x202D" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="0" MaximumValue="3445" DefaultValue="0" Factor="1" Unit="uH"><Description><![CDATA[
       
         Continously calculated Ld when in tuning state CONTINOUS_CALC.
       
      ]]></Description></Parameter><Parameter SymbolName="ContLq" Index="0x202D" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="0" MaximumValue="3445" DefaultValue="0" Factor="1" Unit="uH"><Description><![CDATA[
       
         Continously calculated Ld when in tuning state CONTINOUS_CALC.
       
      ]]></Description></Parameter><Parameter SymbolName="TorqueScaleFactor" Index="0x202D" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
        Externally measured torque.
      ]]></Description></Parameter></Group>

<Group SymbolName="DcBus"><Parameter SymbolName="LastSubIndex" Index="0x2030" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Voltage" Index="0x2030" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
       Measured non-filtered DC bus voltage value.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxMeasuredVoltage" Index="0x2030" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
       Max Measured Voltage for A/D.
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyHighLevel" Index="0x2030" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="110% of 48 * 100" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        If Dc Voltage exceeds this level, a warning is set, and currents
        starts to linearily reduce to 0. When Dc Voltage Reaches ReductionEndHighLevel
        currents is reduced to 0.
       
      ]]></Description></Parameter><Parameter SymbolName="HighLevel" Index="0x2030" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="95% of 67.09 * 100" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        If DC Voltage exceeds this level, the application trips.
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyLowLevel" Index="0x2030" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="75% of 48 * 100" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        If DC Voltage goes below this level, a warning is set, and currents starts
        to linearily reduce to 0. When Dc Voltage Reaches ReductionEndLowLevel
        currents is reduced to 0.
       
      ]]></Description></Parameter><Parameter SymbolName="LowLevel" Index="0x2030" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="50% of 48 * 100" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
       If DC Voltage goes below this level, the application trips.
       Set to 0, to disable trip.
       
     ]]></Description></Parameter><Parameter SymbolName="ReductionEndHighLevel" Index="0x2030" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        If DC Voltage exceeds this level, current is reduced to 0. Set
        to 0, to disable reduction function.
       
      ]]></Description></Parameter><Parameter SymbolName="ReductionEndLowLevel" Index="0x2030" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
       If DC Voltage goes below this level, current is reduced to 0. Set
       to 0, to disable reduction function.
       
      ]]></Description></Parameter><Parameter SymbolName="FilterGain" Index="0x2030" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="320"><Description><![CDATA[
       
        First order filtering coefficient for the Dc Bus Voltage.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
        Note: The filtered Dc Bus Voltage is used by the supervision and the Brake Reduction Curve.
       
      ]]></Description></Parameter><Parameter SymbolName="NominalVoltage" Index="0x2030" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="48 * 100" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
       12, 24, 36, 48, 72, 80, 600 or 650V
       
     ]]></Description></Parameter><Parameter SymbolName="FilteredVoltage" Index="0x2030" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        Used by Dc Bus Voltage supervision.
       
      ]]></Description></Parameter><Parameter SymbolName="ChargingLevel" Index="0x2030" SubIndex="17" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="85% of (0.75 * 48 * 100)" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        The voltage level when charging is said to be finished and "switch on" becomes allowed.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxChargeTime" Index="0x2030" SubIndex="18" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="10000" Factor="1" Unit="ms"><Description><![CDATA[
       
        Max time to charge dc bus in in ms from key on. If set to 0, a timeout will never be set.
       
      ]]></Description></Parameter><Parameter SymbolName="DcBusCalValueGain" Index="0x2030" SubIndex="19" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="67.09 *100" Factor="1" Unit="-"><Description><![CDATA[
       
        Calibrated gain value for DC Bus. Written in production. <b>If not calibrated, write the default value to clear default value events.<b/>
       
      ]]></Description></Parameter><Parameter SymbolName="DcBusCalValueOffset" Index="0x2030" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="centiV"><Description><![CDATA[
       
        Calibrated offset value for DC Bus. Written in production. <b>If not calibrated, write the default value to clear default value events.<b/>
       
      ]]></Description></Parameter><Parameter SymbolName="SetDcBusCalValuesDefault" Index="0x2030" SubIndex="21" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Service" AccessType="wo" MinimumValue="0" MaximumValue="1" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Writing a 1 to this index loads the default values for dc bus calibration.
        The warning bit DefaultCalValues will also be set.
       
      ]]></Description></Parameter><Parameter SymbolName="DcBusOffset" Index="0x2030" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
       Run time offset value. Can be used to adapting the measured value to same
       value as other drives in the sustem.
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalFilteredVoltage" Index="0x2030" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        CAN signal filtered voltage.
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalFilterGain" Index="0x2030" SubIndex="24" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="320" Factor="1" Unit="-"><Description><![CDATA[
        
        First order filtering coefficient for the separately filtered DC voltage signal for CAN.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="AdaptedRawVoltage" Index="0x2030" SubIndex="25" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-"><Description><![CDATA[
       
        0x2030:2 + 0x2030:22
       
      ]]></Description></Parameter><Parameter SymbolName="AdaptedFilteredVoltage" Index="0x2030" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-"><Description><![CDATA[
       
        0x2030:23 + 0x2030:22
       
      ]]></Description></Parameter><Parameter SymbolName="OVPTest" Index="0x2030" SubIndex="27" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="-"><Description><![CDATA[
        
        1 = Start OVP test
        0 = Stop OVP test
       
      ]]></Description></Parameter><Parameter SymbolName="PreCharge" Index="0x2030" SubIndex="28" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0"><Description><![CDATA[
        
        1 = PreCharge off
        0 = PreCharge on
       
      ]]></Description></Parameter><Parameter SymbolName="OVPStatus" Index="0x2030" SubIndex="29" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="1" DefaultValue="-"><Description><![CDATA[
        
        1 = OVP protection function on
        0 = OVP protection function off
       
      ]]></Description></Parameter></Group>

<Group SymbolName="InternalVoltageSupplies"><Parameter SymbolName="LastSubIndex" Index="0x2039" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="KeyVoltage" Index="0x2039" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
        Key voltage level.
       
      ]]></Description></Parameter><Parameter SymbolName="5V" Index="0x2039" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
        Internal 5V supply voltage level.<br/>
        Related events: 1701 - 5VOutOfRange
       
      ]]></Description></Parameter><Parameter SymbolName="15V" Index="0x2039" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
        Internal 15V supply voltage level.<br/>
        Related events: 1700 - 15VOutOfRange
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplyRefVoltage" Index="0x2039" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
        Internal Sensor Supply voltage reference level.<br/>
        Related events: 810 - SensSupRefRange
        For the external voltage refer to SensorSupply1OutputVoltage
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplyVoltage" Index="0x2039" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
        Internal Sensor Supply voltage level.<br/>
        Related events: 811 - SensorSupRange
        For the external voltage refer to SensorSupply1OutputVoltage
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplyCurrent" Index="0x2039" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="mA"><Description><![CDATA[
       
        Sensor Supply current consumption. <br/>
        SensorSupplyCurrent = (SensorSupplyRefVoltage - SensorSupplyVoltage) / 15      <br/>
        Related events: <br/>
        800 - SensorSupNotCon <br/>
        801 - SensorSupSHC
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplyRefGain" Index="0x2039" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="4.06 *1000" Factor="0.001" Unit="mV/bit"><Description><![CDATA[
       
        Gain for Internal Sensor Supply Reference voltage measurement. Written in production.
        <b>If not calibrated, write the default value to clear default value events.<b/>
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplyGain" Index="0x2039" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="4.06 *1000" Factor="0.001" Unit="mV/bit"><Description><![CDATA[
       
        Gain for Sensor Supply voltage measurement. Written in production.
        <b>If not calibrated, write the default value to clear default value events.<b/>
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplySetGainDefault" Index="0x2039" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="wo" MinimumValue="1" MaximumValue="1" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Write 1 to set default calibrated gain values for SensorSupplyRefGain and SensorSupplyGain.
       
      ]]></Description></Parameter><Parameter SymbolName="5VC" Index="0x2039" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
        Internal 5V C supply voltage level.<br/>
        Related events: 1709 - 5VCOutOfRange
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupplyCurrentMin" Index="0x2039" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0.000 * 1000" Factor="1" Unit="mA"><Description><![CDATA[
       
          SensorSupplyCurrentMin level. If SensorSupplyCurrentMin is greater than SensorSupplyCurrent, it will set SensorSupNotCon event.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSupply1OutputVoltage" Index="0x2039" SubIndex="28" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="0.01" Unit="V"><Description><![CDATA[
       
          External - SensorSupply1OutputVoltage. The external output voltage of the sensor supply 1.<br/>
          Related event: 1735 - SensorSupply1OutputVoltage_OutOfRange
       
      ]]></Description></Parameter></Group>

<Group SymbolName="MotorTemperature"><Parameter SymbolName="LastSubIndex" Index="0x2040" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Temperature" Index="0x2040" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-50" MaximumValue="210" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
       
        Motor Temperature.
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyLowLevel" Index="0x2040" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-35" Factor="1" Unit="degC"><Description><![CDATA[
       
        Level at which a Low Temp Status will become active.
       
      ]]></Description></Parameter><Parameter SymbolName="ReductionEndLowLevel" Index="0x2040" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="0" Factor="1" Unit="degC"><Description><![CDATA[
       
        Temperature level at which the linear current reduction will be at full reduction (no current) due to low temperature.<br/>
        Only accelerating current is reduced. Optionally also braking current can be reduced.<br/>
        Reduction starts from Moderately Low Level. Set to 0, to disable reduction function.<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyHighLevel" Index="0x2040" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="100" Factor="1" Unit="degC"><Description><![CDATA[
       
        Level at which a Moderately High Temp Status will become active.
       
      ]]></Description></Parameter><Parameter SymbolName="ReductionEndHighLevel" Index="0x2040" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="120" Factor="1" Unit="degC"><Description><![CDATA[
       
        Temperature level at which the linear current reduction will be at full reduction (no current) due to high temperature.<br/>
        Only accelerating current is reduced. Optionally also braking current can be reduced.<br/>
        Reduction starts from Moderately High Level. Set to 0, to disable reduction function.<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="HighLevel" Index="0x2040" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="130" Factor="1" Unit="degC"><Description><![CDATA[
       
        Level at which a High Temp Status will become active.
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalMotorTemp" Index="0x2040" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-50" MaximumValue="210" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
        
      Motor Temperature.
      
      ]]></Description></Parameter><Parameter SymbolName="CanSignalMotorTempFilterGain" Index="0x2040" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="2000" Factor="1"><Description><![CDATA[
        
    Filter gain for separately filtered motor temperature signal for CAN.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 50) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 50)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
    
      ]]></Description></Parameter><Parameter SymbolName="ShortCircuitLevel" Index="0x2040" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="-50" Factor="1" Unit="degC"><Description><![CDATA[
       
        Level at which a Short Circuit Status will become active.
       
      ]]></Description></Parameter><Parameter SymbolName="NotConnectedLevel" Index="0x2040" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-3276" MaximumValue="3276" DefaultValue="210" Factor="1" Unit="degC"><Description><![CDATA[
       
        Level at which a Not Connected Status will become active.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorTypeSelect" Index="0x2040" SubIndex="16" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="5" DefaultValue="0"><Description><![CDATA[
       
       Selectable Motor Temperature Sensors
       <table>
          <tr> <th>Sensor Type</th>  <th>Name/th></tr>
          <tr> <td>0</td>             <td>Custom</td></tr>
          <tr> <td>1</td>             <td>KTY81_110</td></tr>
          <tr> <td>2</td>             <td>KTY84_150</td></tr>
          <tr> <td>3</td>             <td>PT1000</td></tr>
          <tr> <td>4</td>             <td>NOT_AVAILABLE</td></tr>
       </table> <br/>
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="CUSTOM_SENSOR"/>
        <ValueFieldDef Value="1" Description="KTY81_110"/>
        <ValueFieldDef Value="2" Description="KTY84_150"/>
        <ValueFieldDef Value="3" Description="PT1000"/>
        <ValueFieldDef Value="4" Description="NOT_AVAILABLE"/>
      </ValueFieldDefs></Parameter></Group>

<Group SymbolName="PowerStageTemperature"><Parameter SymbolName="LastSubIndex" Index="0x2041" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Temperature" Index="0x2041" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-50" MaximumValue="130" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
       
        Heatsink Temperature.<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalInverterTemp" Index="0x2041" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-50" MaximumValue="130" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
        
        Separately filtered heat sink temperature.
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalInverterTempFilterGain" Index="0x2041" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="350" Factor="1"><Description><![CDATA[
        
        Filter gain for separately filtered heat sink temperature signal for CAN<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 50) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 50)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
        
      ]]></Description></Parameter></Group>

<Group SymbolName="PCBTemperature"><Parameter SymbolName="LastSubIndex" Index="0x2044" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Temperature1" Index="0x2044" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-50" MaximumValue="120" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
       
        Pcb Temperature.<br/>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="MotorTemperatureTableAD"><Parameter SymbolName="LastSubIndex" Index="0x2045" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="2" MaximumValue="15" DefaultValue="11" Factor="1" Unit="-"><Description><![CDATA[
        Size of look-up table.
      ]]></Description></Parameter><Parameter SymbolName="TemperatureTableAD" Index="0x2045" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
         AD-value (16-bit) for the corresponding temperature.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="MotorTemperatureTableDeg"><Parameter SymbolName="LastSubIndex" Index="0x2046" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="2" MaximumValue="15" DefaultValue="11" Factor="1" Unit="-"><Description><![CDATA[
        Size of look-up table.
      ]]></Description></Parameter><Parameter SymbolName="TemperatureTableDeg" Index="0x2046" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-200" MaximumValue="300" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
       
         Temperature for the corresponding AD-value.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="ActualMotorTemperatureTableAD"><Parameter SymbolName="LastSubIndex" Index="0x2047" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="2" MaximumValue="15" DefaultValue="11" Factor="1" Unit="-"><Description><![CDATA[
        Size of look-up table.
      ]]></Description></Parameter><Parameter SymbolName="ActualTemperatureTableAD" Index="0x2047" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="OEM" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
         AD-value (16-bit) for the corresponding temperature.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="ActualMotorTemperatureTableDeg"><Parameter SymbolName="LastSubIndex" Index="0x2048" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="2" MaximumValue="15" DefaultValue="11" Factor="1" Unit="-"><Description><![CDATA[
        Size of look-up table.
      ]]></Description></Parameter><Parameter SymbolName="ActualTemperatureTableDeg" Index="0x2048" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="OEM" AccessType="ro" MinimumValue="-200" MaximumValue="300" DefaultValue="-" Factor="1" Unit="degC"><Description><![CDATA[
       
         Temperature for the corresponding AD-value.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="EnergyLimit"><Parameter SymbolName="LastSubIndex" Index="0x2050" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="ConstantCurrentLimit" Index="0x2050" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Current below this limit will not create energy limitation.<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="ReductionPgain" Index="0x2050" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1"><Description><![CDATA[
       
        This gain multipied with energy gives the reduction.<br/>
        Setting gain to 0 disables the energy limit reduction function.<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="EnergyFilterGain" Index="0x2050" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="16384" Factor="1"><Description><![CDATA[
       
        First order filtering coefficient to estimate energy.</br></br>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) </br>
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="Reduction" Index="0x2050" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="0" MaximumValue="256" Factor="1"><Description><![CDATA[
       
        The resulting reduction due to estimated power stage energy.</br></br>
        <ul>
         <li>0, means full reduction</li>
         <li>256, means no reduction</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentForEnergyFilterInit" Index="0x2050" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Initial current level that determines the initial value of the energy filter.<br/>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="PmFeedbackSensorOffsetCalibration"><Parameter SymbolName="LastSubIndex" Index="0x2051" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="State" Index="0x2051" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1"><Description><![CDATA[
       
        <p>
        Write 1 to start the calibration routine.
        Drive has to be enabled, motor should be able to spin freely in both directions.
        </p>
        <p>
        <strong>It highly recommended to set <a href="#CANParameters.SdoTimeout">SDO Timeout</a>!</strong><br/>
        If regenerative braking is not allowed (a power supply is used), set
        <a href="#CurrentLimit.MaxBrakeCurrent">max brake current</a> to 0.
        </p>
        <ol start="0">
          <li>Idle</li>
          <li>Start rough calibration</li>
          <li>Rough calibration</li>
          <li>Start fine calibration</li>
          <li>Fine calibration</li>
          <li value="254">Success</li>
          <li value="255">Error</li>
        </ol>
        <p>
        At end of calibration, the drive is left in AC current control.
        It is recommended to reset the drive after completion to make sure the drive is in
        a well defined state before continuing.
        </p>
        <b> PM Motor Only </b> <br/>
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Idle"/>
        <ValueFieldDef Value="1" Description="Start rough calibration"/>
        <ValueFieldDef Value="2" Description="Rough calibration"/>
        <ValueFieldDef Value="3" Description="Start fine calibration"/>
        <ValueFieldDef Value="4" Description="Fine calibration"/>
        <ValueFieldDef Value="254" Description="Success"/>
        <ValueFieldDef Value="255" Description="Error"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="OpenLoopSpeed" Index="0x2051" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="300" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        The speed to rotate with open loop feedback. <br/>
        <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="OpenLoopCurrent" Index="0x2051" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="91" Factor="1" Unit="Arms"><Description><![CDATA[
       
       The d-axis current to apply when pulling motor without angle feedback. <br/>
       <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="AccAndBrakeCurrent" Index="0x2051" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="55" Factor="1" Unit="Arms"><Description><![CDATA[
       
       The AC current to apply when accelerating and decelerating motor. <br/>
       <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="AccelerationTimeout" Index="0x2051" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="5000" Factor="1" Unit="ms"><Description><![CDATA[
       
        The maximum allowed time when accelerating motor. <br/>
       <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="MaxUpeak" Index="0x2051" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="7000" Factor="1" Unit="-"><Description><![CDATA[
       
        Target AC voltage required for measuring voltage angle. <br/>
        <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="MaxAngleAdjustment" Index="0x2051" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1799" DefaultValue="30" Factor="0.1" Unit="Deg"><Description><![CDATA[
      
        Fine alignment will be re-run if final adjustment was larger than this value. <br/>
        <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="MaxNumberOfRetries" Index="0x2051" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" DefaultValue="2" Factor="1" Unit="no"><Description><![CDATA[
       
        Max number of re-runs. <br/>
        <b> PM Motor Only </b> <br/>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="FeedbackSensor"><Parameter SymbolName="LastSubIndex" Index="0x2052" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="RotorSpeedInRpm" Index="0x2052" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Shows value from the active feedback.  <br/>
        If FeedbackMode is 0 the physical sensor speed is shown.  <br/>
        If FeedbackMode is 1 the parameter FrequencyWhenNoSpeedFeedback speed is shown.  <br/>
        If FeedbackMode is 2 the CommandSpeeed is shown.  <br/>
        If FeedbackMode is 3 sensorless closed loop feedback speed is shown.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorAngleAligned" Index="0x2052" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Sensorangle in deciDegrees. Does not take into account number of sensor poles. <br/>
        Can be written to if FeedbackMode is 1.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorAngleOffset" Index="0x2052" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-1800" MaximumValue="1799" DefaultValue="0" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Sensorangle offset in deciDegrees. Added to SensorAngle before number of sensor poles is handled. <br/>
        Used by PM motor to align rotor and posistion sensor. Calibration parameter.
       
      ]]></Description></Parameter><Parameter SymbolName="DeltaSensorLowResAngle" Index="0x2052" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="incs/timeunit"><Description><![CDATA[
       
        Change of Sensorangle per 250 us in Q15 format.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorLowResAngleAligned" Index="0x2052" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="incs"><Description><![CDATA[
       
        Sensorangle in Q15.
       
      ]]></Description></Parameter><Parameter SymbolName="DeltaSensorAngle" Index="0x2052" SubIndex="6" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" DefaultValue="-" Factor="1" Unit="incs/timeunit"><Description><![CDATA[
       
        Change of Sensorangle per 250 us in Q31 format.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorAngleAlignedInternal" Index="0x2052" SubIndex="7" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" DefaultValue="-" Factor="1" Unit="incs"><Description><![CDATA[
       
        Sensorangle in Q31.
       
      ]]></Description></Parameter><Parameter SymbolName="Acceleration" Index="0x2052" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="incs"><Description><![CDATA[
       
        Rotor accleration in Rpm/20ms.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorPolePairs" Index="0x2052" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="1" MaximumValue="32767" Factor="1" Unit="no"><Description><![CDATA[
       
        Number of sensor pole pairs. Normally 1 except for resolver and analog hall sensors.
       
      ]]></Description></Parameter><Parameter SymbolName="FeedbackMode" Index="0x2052" SubIndex="10" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="3" DefaultValue="SFIFMG_PHYSICAL_FEEDBACK_CLOSED_LOOP" Factor="1" Unit="-"><Description><![CDATA[
       
        The rotor position and speed used for commutation and speed control can be taken from difference
        sources.  </br></br>
        If FeedbackMode is 0 the commutation angle and speed is taken from the physical sensor.
        To be used for closed loop control with physical sensor. </br></br>
        If FeedbackMode is 1 the commutation angle and speed is taken from the parameter FrequencyWhenNoSpeedFeedback.
        To be used for open loop control with stator commutuation explicitly controlled whitout
        considering MotorPoles or SensorPolePaires. </br></br>
        If FeedbackMode is 2 the commutation angle and speed is taken from CommandSpeeed.
        To be used for open loop control when the commutation speed shall result in that the shaft speed gets close to CommandSpeed.
        Set the ControlMode to SpeedMode and limit the speed change with CommandAccelerationChange and CommandDeccelerationChange</br></br>
        If FeedbackMode is 3 the commutation angle and speed is taken from what the sensorless algorithm calculate.
        Only applicable for induction machine.
        To be used for closed loop control when physical sensor do not exsist or has failed.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Physical sensor"/>
        <ValueFieldDef Value="1" Description="Simulated sensor frequency"/>
        <ValueFieldDef Value="2" Description="Simulated rotor speed"/>
        <ValueFieldDef Value="3" Description="Sensorless"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="FrequencyWhenNoSpeedFeedback" Index="0x2052" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
       <p>Set value for sensor speed (i.e. frequency) when FeedbackMode is 1. </p>
       <p>The value 65536 corresponds to 4000 Hz sensor frequency. The rotor (mechanical) frequency is sensor frequency divided with number of sensor pole pairs. </p>
       
      ]]></Description></Parameter><Parameter SymbolName="SensorSpeedInRpm" Index="0x2052" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Shows value from the physical feedback sensor, even when FeedbackMode is different from 0.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedFilterGain" Index="0x2052" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" Factor="1" Unit="-"><Description><![CDATA[
       
        First order filtering coefficient for the speed used in the speed control.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="AccelerationFilterGain" Index="0x2052" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="1280" Factor="1" Unit="-"><Description><![CDATA[
       
        First order filtering coefficient for the Acceleration.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 50) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 50)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="SensorLowResAngle" Index="0x2052" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="incs"><Description><![CDATA[
       
        Shows value from the active feedback sensor even when SpeedFeedbackSensorDisabled is set in Q15.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorAngle" Index="0x2052" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-1800" MaximumValue="1799" DefaultValue="-" Factor="0.1" Unit="Deg"><Description><![CDATA[
       
        Shows value from the active feedback sensor even when SpeedFeedbackSensorDisabled is set in deciDegrees.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedCalculationCounter" Index="0x2052" SubIndex="17" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Can be used by an external controller to verify that the speed calculation function has been executed. <br/>
        For example, an APS (steer controller) can be set up to monitor the speed calculation in the vehicle controller as
        as part of the traction speed supervision.  <br/> <br/>
        When communicated via PDO, make sure that transmission period is less than 64ms to avoid wrap around issue. <br/>
        i.e. Overflow = 256 [8bits] / 4000 [speed calc rate] * 1000 [ms] = 64ms.
       
      ]]></Description></Parameter><Parameter SymbolName="SensorDirectionInverted" Index="0x2052" SubIndex="18" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1" Factor="1" Unit="-"><Description><![CDATA[
       
        This OD does not apply for SIXSTEP feedback sensor.<br/>
        False (0) = The two sensor channels not shifted<br/>
        True (1) = The two sensor channels shifted<br/>
        This setting shall be set according to the definition of the two feedback sensor channels.
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalRotorSpeedInRpm" Index="0x2052" SubIndex="19" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="Rpm"><Description><![CDATA[
        
        Shows value from the separately filtered feedback.  <br/>
        If FeedbackMode is 0 the physical sensor speed is shown.  <br/>
        If FeedbackMode is 1 the parameter FrequencyWhenNoSpeedFeedback speed is shown.  <br/>
        If FeedbackMode is 2 the CommandSpeeed is shown.  <br/>
        If FeedbackMode is 3 sensorless closed loop feedback speed is shown.
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalSpeedFilterGain" Index="0x2052" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="320" Factor="1" Unit="-"><Description><![CDATA[
        
        First order filtering coefficient for the separately filtered CAN signal speed.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="SensorTypeSelect" Index="0x2052" SubIndex="21" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="-"><Description><![CDATA[
        
        Select sensor pullup configurations. One bit for each sensor.</br>
        Bit value 0 = pullup (digital sensor)</br>
        Bit value 1 = no pullup (analog sensor)</br>
        <br/>
        Following is a list of available sensors for this specific product.</br>
        Note, the meaning of each bit varies dynamic with different products.</br>
        The list is adjusted packed to the least significant bits in the value, starting with the sensor for bit0 in the list.</br>
        <ul>
             <li>Encoder 1 Pull-Up </li>
             <li>Encoder 1C Pull-Up </li>
        </ul>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="SinCosSensor"><Parameter SymbolName="LastSubIndex" Index="0x2053" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1mVSignal" Index="0x2053" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="-" Factor="1" Unit="mV"><Description><![CDATA[
       
        Signal1 level in mV.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2mVSignal" Index="0x2053" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="-" Factor="1" Unit="mV"><Description><![CDATA[
       
        Signal2 level in mV.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1mVOffsetAdjusted" Index="0x2053" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        The automatically adjusted Signal1 offset in millvolt. <br/>
        At startup this parameter will be initiated to the value of <a href="#SinCosSensor">Sensor1mVOffset</a>. <br/>
        This is the offset that is actually used to calculate sensor angle. <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2mVOffsetAdjusted" Index="0x2053" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        The automatically adjusted Signal2 offset in millvolt. <br/>
        At startup this parameter will be initiated to the value of <a href="#SinCosSensor">Sensor2mVOffset</a>. <br/>
        This is the offset that is actually used to calculate sensor angle. <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1mVAmplitudeAdjusted" Index="0x2053" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="1" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        The automatically adjusted Signal1 amplitude in millvolt. <br/>
        At startup this parameter will be initiated to the value of <a href="#SinCosSensor">Sensor1mVAmplitude</a>. <br/>
        This is the amplitude that is actually used to calculate sensor angle. <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2mVAmplitudeAdjusted" Index="0x2053" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="1" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        The automatically adjusted Signal2 amplitude in millvolt. <br/>
        At startup this parameter will be initiated to the value of <a href="#SinCosSensor">Sensor2mVAmplitude</a>. <br/>
        This is the amplitude that is actually used to calculate sensor angle. <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="NormaliseSensorInputs" Index="0x2053" SubIndex="22" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="wo" MinimumValue="3" MaximumValue="3" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Use unfiltered window to calculate gain and offset. Can be used if default gain or offset is wrong and the drive does not see that the sensor is turning.
        After drive reset rotate the sensor a little over one turn but not more than two turns before using this function. Write the value 3 to use this function.
        Then manually store the new offsets and gains to EEPROM if successful.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1NormalisedSignal" Index="0x2053" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Normalized level for signal 1 in Base 2000h.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2NormalisedSignal" Index="0x2053" SubIndex="24" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Normalized level for signal 2 in Base 2000h.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1NormalisedOffsetAdjusted" Index="0x2053" SubIndex="25" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="16380" Factor="1" Unit="-"><Description><![CDATA[
       
        Offset for signal 1. Normalised to internal scaling. <br/>
        At startup the intitial value will be calculated from the parameter <a href="#SinCosSensor">Sensor1mVOffset</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1NormalisedGainAdjusted" Index="0x2053" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Gain for signal 1. Normalised to internal scaling. <br/>
        At startup the intitial value will be calculated from the parameter <a href="#SinCosSensor">Sensor1mVAmplitude</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2NormalisedOffsetAdjusted" Index="0x2053" SubIndex="27" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="16380" Factor="1" Unit="-"><Description><![CDATA[
       
        Offset for signal 2. Normalised to internal scaling. <br/>
        At startup the intitial value will be calculated from the parameter <a href="#SinCosSensor">Sensor2mVOffset</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2NormalisedGainAdjusted" Index="0x2053" SubIndex="28" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Gain for signal 2. Normalised to internal scaling. <br/>
        At startup the intitial value will be calculated from the parameter <a href="#SinCosSensor">Sensor2mVAmplitude</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1WindowMin" Index="0x2053" SubIndex="29" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Min AD value for signal 1 (AD value shifted down 1). Filtered window updated every 2 turns of the sensor.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1WindowMax" Index="0x2053" SubIndex="30" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Max AD value for signal 1 (AD value shifted down 1). Filtered window updated every 2 turns of the sensor.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2WindowMin" Index="0x2053" SubIndex="31" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Min AD value for signal 2 (AD value shifted down 1). Filtered window updated every 2 turns of the sensor.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2WindowMax" Index="0x2053" SubIndex="32" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Max AD value for signal 2 (AD value shifted down 1). Filtered window updated every 2 turns of the sensor.
       
      ]]></Description></Parameter><Parameter SymbolName="NormalisedSin2Cos2" Index="0x2053" SubIndex="33" ObjectType="VAR" DataType="INTEGER32" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="2147483647" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Unit circle value calculated as (Sensor1NormalisedSignal^2 + Sensor2NormalisedSignal^2).<br/>
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1mVOffset" Index="0x2053" SubIndex="36" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        Signal1 offset default value in millvolt. <br/>
        The <a href="#SinCosSensor">Sensor1mVOffsetAdjusted</a> will be initiated to this value at startup. <br/>
        When changing this parameter you must save it to eeprom and then restart the unit. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2mVOffset" Index="0x2053" SubIndex="37" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        Signal2 offset default value in millvolt. <br/>
        The <a href="#SinCosSensor">Sensor2mVOffsetAdjusted</a> will be initiated to this value at startup. <br/>
        When changing this parameter you must save it to eeprom and then restart the unit. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor1mVAmplitude" Index="0x2053" SubIndex="38" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        Signal1 amplitude default value in millvolt. The peak to peak value is 2 * Sensor1mVAmplitude. <br/>
        The <a href="#SinCosSensor">Sensor1mVAmplitudeAdjusted</a> will be initiated to this value at startup. <br/>
        When changing this parameter you must save it to eeprom and then restart the unit. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="Sensor2mVAmplitude" Index="0x2053" SubIndex="39" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        Signal1 amplitude default value in millvolt. The peak to peak value is 2 * Sensor2mVAmplitude. <br/>
        The <a href="#SinCosSensor">Sensor2mVAmplitudeAdjusted</a> will be initiated to this value at startup. <br/>
        When changing this parameter you must save it to eeprom and then restart the unit. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="ActivateCalibration" Index="0x2053" SubIndex="40" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="1" Factor="1" Unit="-"><Description><![CDATA[
       
        Activate or deactivate the automatic offset and amplitude adjustment of
        sine and cosine signals.
       
      ]]></Description></Parameter><Parameter SymbolName="SampleTimeDelay" Index="0x2053" SubIndex="41" ObjectType="VAR" DataType="INTEGER32" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="250000" DefaultValue="0" Factor="1" Unit="ns"><Description><![CDATA[
       
        <p>Use this to compensate for when a sensor reading returns a seemingly
        old value.</p>
        <p>This can be observed for example when only using a high d-current
        only but the externally measured torque changes with speed.</p>
       
      ]]></Description></Parameter><Parameter SymbolName="Sin2Cos2" Index="0x2053" SubIndex="42" ObjectType="VAR" DataType="INTEGER32" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="2147483647" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Unit circle value calculated as (Sensor1Signal^2 + Sensor2Signal^2).
       
      ]]></Description></Parameter><Parameter SymbolName="MaxAmplitude" Index="0x2053" SubIndex="43" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="1" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        The maximum allowed amplitude for the configured sensor before gain or unit circle error. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="MinAmplitude" Index="0x2053" SubIndex="44" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="1" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        The minimum allowed amplitude for the configured sensor before gain or unit circle error. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxDeltaNominalOffset" Index="0x2053" SubIndex="45" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="(5500L)" DefaultValue="0" Factor="1" Unit="mV"><Description><![CDATA[
       
        Max +/- variation allowed in offset level. Writing to this value will
        also update the corresponding parameter for the active sensor configuration <a href="#ConfigurationManager">ActualSensorType</a>.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="SensorBearingFeedback"><Parameter SymbolName="LastSubIndex" Index="0x2058" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="HwResolution" Index="0x2058" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="no"><Description><![CDATA[
       
        Pulses per revolution per channel.
       
      ]]></Description></Parameter><Parameter SymbolName="PulseCheckChannelLowSpeedLimit" Index="0x2058" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Used for detection of one broken sensor channel at low speeds. If one channel has no pulses
        but the other channel shows a speed higher than the limit the Loss of Channel X event will be set.
        <p>Set to zero for no detection. Recommended value for detection is 50-100 rpm.</p>
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedPlausibleHighLimit" Index="0x2058" SubIndex="4" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Used for detection of faulty sensor. If sensor reports non plausible value the corresponding
       fault is activated.
       
      ]]></Description></Parameter><Parameter SymbolName="HardwareCaptureValue" Index="0x2058" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Number of pulse edges captured. The pulse edges per revolution equals 4 * SensorPulsesPerRevolution.
       
      ]]></Description></Parameter><Parameter SymbolName="CaptureValue" Index="0x2058" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Number of pulse edges captured. The pulse edges per revolution equals 4 * SensorPulsesPerRevolution * Virtual resolution.
       
      ]]></Description></Parameter><Parameter SymbolName="DeltaCaptureValue" Index="0x2058" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0"><Description><![CDATA[
       
        Number of pulse edges captured per ms.
       
      ]]></Description></Parameter><Parameter SymbolName="EncoderSector" Index="0x2058" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Encoder sector counts from 0 to hwresolution*number of captures per pulse.
       
      ]]></Description></Parameter><Parameter SymbolName="SizeOfErrorAtZCorrection" Index="0x2058" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        The size of the difference of the encoder sector angle and the defined z pulse index angle. Note that the error can be the maximum value of encoder sector wihch should also be treated as 0.
       
      ]]></Description></Parameter><Parameter SymbolName="FirstZPulseHasBeenDetected" Index="0x2058" SubIndex="12" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        State switch which indicates if the first z-pulse has been detected.
       
      ]]></Description></Parameter><Parameter SymbolName="SecondAngleCorrectionDone" Index="0x2058" SubIndex="13" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       After one turn of the rotor, status = 1 if the target z-edge was detected. The correction angle should from now on be close to zero otherwise an error event will be activated.
       
      ]]></Description></Parameter><Parameter SymbolName="LengthOfZPulse" Index="0x2058" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-" MaximumValue="-" DefaultValue="12" Factor="1" Unit="-"><Description><![CDATA[
       
       Length of the Z pulse (index pulse) in number of pulses. This parameter will change one of the Z pulse reference angles.
       
      ]]></Description></Parameter><Parameter SymbolName="ZPulseCorrectioSectorSize" Index="0x2058" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-" MaximumValue="-" DefaultValue="12/2" Factor="1" Unit="-"><Description><![CDATA[
       
       Adjust the correction sector size (window) where a sensor angle adjustment is allowed.
       
      ]]></Description></Parameter><Parameter SymbolName="NoZPulseDetectedLimit" Index="0x2058" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Number of counted encoder sector values where a detecton of a Z pulse is expected. Abowe this value the drive will trip.
       
      ]]></Description></Parameter><Parameter SymbolName="ZPulseCapterValue" Index="0x2058" SubIndex="17" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       The current Z capture on quadrature inputs (ChA and ChB).
       
      ]]></Description></Parameter><Parameter SymbolName="TimeDeltaSensorAngle" Index="0x2058" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       DeltaSensorAngle as produced by the Pulse Delta Time Measurement. Regardless of the setting of UseTimeMeasurement.
       
      ]]></Description></Parameter><Parameter SymbolName="TimeFrequency" Index="0x2058" SubIndex="21" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Pulse Frequency for channel 1 as measured by the Pulse Delta Time Measurement. Regardless of the setting of UseTimeMeasurement.
       
      ]]></Description></Parameter><Parameter SymbolName="TimeRpm" Index="0x2058" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Rpm as produced by the Pulse Delta Time Measurement. Regardless of the setting of UseTimeMeasurement.
       
      ]]></Description></Parameter><Parameter SymbolName="TimeDir" Index="0x2058" SubIndex="23" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Direction used by Pulse Delta Time Measurement. Regardless of the setting of UseTimeMeasurement.
       
      ]]></Description></Parameter><Parameter SymbolName="UseTimeMeasurement" Index="0x2058" SubIndex="24" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Enable TimeMeasurement method to calculate the speed for encoder (RPM, DeltaAngle etc).
       Not available on Supervisor.
       
      ]]></Description></Parameter><Parameter SymbolName="TimeQuadUpperLimit" Index="0x2058" SubIndex="25" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Upper limit for TimeDeltaSensorAngle signal saturation/"lock in" against quadrature DeltaSensorAngle. If outside, event DeltaTimeToQuadMismatch will be set.
       
      ]]></Description></Parameter><Parameter SymbolName="TimeQuadLowerLimit" Index="0x2058" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-" MaximumValue="-" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
       Lower limit for TimeDeltaSensorAngle signal saturation/"lock in" against quadrature DeltaSensorAngle. If outside, event DeltaTimeToQuadMismatch will be set.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="SixstepSensorFeedback"><Parameter SymbolName="LastSubIndex" Index="0x2059" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="SixstepState" Index="0x2059" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="1" MaximumValue="6" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        State of sixstep sensor. Each state represents 60 degrees of 1 sensor turn.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputGeneral"><Parameter SymbolName="LastSubIndex" Index="0x2060" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Frequency" Index="0x2060" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="16" Factor="1" Unit="kHz"><Description><![CDATA[
       
        Open Drain Output Switching Frequency
       
       
        (4, 8 or 16 kHz).
       
      ]]></Description></Parameter><Parameter SymbolName="OpenDrainOutputControlWord" Index="0x2060" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Bitmask Enable/Disable (1/0) open drain outputs:
        <ul>
         <li>Open drain output 1 -> bit 0</li>
         <li>Open drain output n -> bit n-1</li>
        </ul>
        See comment on CommandAllControlled on restrictions on setting the outputs.<br/>
        If an Open Drain output has tripped due to a short circuit, for example, the Open Drain output has to be disabled
        and re-enabled to be activated again after the fault condition has been removed.
       
      ]]></Description></Parameter><Parameter SymbolName="CommandAllControlled" Index="0x2060" SubIndex="4" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
       Bitmask:
       <ul>
        <li>
         1 = Open drain output n is set based on command bit in CommandAll. Open drain
             output n setting based on OpenDrainOutputControlWord is ignored.
        </li>
        <li>
         0 = Open drain output n is set based on control word bit set in OpenDrainOutputControlWord. Command
             bit n set in CommandAll is ignored
        </li>
       </ul>
       <p>Open drain output 1 -> bit 0<br/>
          Open drain output n -> bit n-1</p>
       
      ]]></Description></Parameter><Parameter SymbolName="MainContactor" Index="0x2060" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="6" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Set which Open Drain Output to use as main contactor. 0=none or 1..n where n=maximum number of open drains used.
       
      ]]></Description></Parameter><Parameter SymbolName="OpenDrainOutputStatusWord" Index="0x2060" SubIndex="7" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Bitmask showing actual Enable/Disable (1/0) status of open drain outputs:
        <ul>
         <li>Open drain output 1 -> bit 0</li>
         <li>Open drain output n -> bit n-1</li>
        </ul>
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputMode"><Parameter SymbolName="LastSubIndex" Index="0x2061" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="OutputMode" Index="0x2061" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="4" DefaultValue="1" Factor="1" Unit="-"><Description><![CDATA[
       
       <table id="ET">
        <tr id="ETHead"><th>Value</th><th id="ETHead">Description</th></tr>
        <tr id="ETRow"><td>0</td>  <td id="ETData">Output Not Used. Output is disabled</td></tr>
        <tr id="ETRow"><td>1</td>  <td id="ETData">General output. Open Drain is on/off controlled only</td></tr>
        <tr id="ETRow"><td>2</td>
          <td id="ETData">Voltage Control.<br/>
          <b>Related control parameters:</b><br/>
          <a href="#OpenDrainOutputPullTime.PullTime">OpenDrainOutputPullTime.PullTime</a><br/>
          <a href="#OpenDrainOutputPullVoltage.PullVoltage">OpenDrainOutputPullVoltage.PullVoltage</a><br/>
          <a href="#OpenDrainOutputHoldVoltage.HoldVoltage">OpenDrainOutputHoldVoltage.HoldVoltage</a></td></tr>
        <tr id="ETRow"><td>3</td>
          <td id="ETData">Current Control.<br/>
          <b>Related control parameters:</b><br/>
          <a href="#OpenDrainOutputCurrentReference.CurrentReference">OpenDrainOutputCurrentReference.CurrentReference</a><br/>
          <a href="#OpenDrainOutputDitheringCurrentFrequency.DitherFrequency">OpenDrainOutputDitheringCurrentFrequency.DitherFrequency</a><br/>
          <a href="#OpenDrainOutputDitheringCurrentAmplitude.DitherAmplitude">OpenDrainOutputDitheringCurrentAmplitude.DitherAmplitude</a></td></tr>
        <tr id="ETRow"><td>4</td>
          <td id="ETData">Manual PWM Control.<br/>
          <b>Related control parameters:</b><br/>
          <a href="#OpenDrainOutputPWMLevel.PWMLevel">OpenDrainOutputPWMLevel.PWMLevel</a><br/>
          <a href="#OpenDrainOutputPeriod.Period"/>OpenDrainOutputPeriod.Period</a></td></tr>
       </table>
        For mode 2 and 3 the DC Bus voltage must be above 1/8th of the nominal voltage for the open drain to be activated.
        In manual mode it is possible to set the pwm level manually.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputPullTime"><Parameter SymbolName="LastSubIndex" Index="0x2062" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PullTime" Index="0x2062" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="ms"><Description><![CDATA[
       
        During this time the Pull Voltage or Pull Current is generated. <br/>
        Pull time for Open Drain Output 1...N.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">0</td></tr>
          <tr id="ETRow"><td>2</td>  <td id="ETData">0</td></tr>
           <tr id="ETRow"><td>3</td>  <td id="ETData">0</td></tr>
           <tr id="ETRow"><td>4</td>  <td id="ETData">0</td></tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputPullVoltage"><Parameter SymbolName="LastSubIndex" Index="0x2063" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PullVoltage" Index="0x2063" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        Initial (during pull time) voltage between B+ and output when output is enabled. <br/>
        Pull voltage for Open Drain Output 1...N.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">((F32) 48 * 0.5)</td></tr>
          <tr id="ETRow"><td>2</td>  <td id="ETData">((F32) 48 * 0.5)</td></tr>
           <tr id="ETRow"><td>3</td>  <td id="ETData">((F32) 48 * 0.5)</td></tr>
           <tr id="ETRow"><td>4</td>  <td id="ETData">((F32) 48 * 0.5)</td></tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputHoldVoltage"><Parameter SymbolName="LastSubIndex" Index="0x2064" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="HoldVoltage" Index="0x2064" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="0.01" Unit="Vdc"><Description><![CDATA[
       
        Voltage that follows upon the Pull Voltage. <br/>
        Hold voltage for Open Drain Output 1...N.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">((F32) 48 * 0.3)</td></tr>
          <tr id="ETRow"><td>2</td>  <td id="ETData">((F32) 48 * 0.3)</td></tr>
           <tr id="ETRow"><td>3</td>  <td id="ETData">((F32) 48 * 0.3)</td></tr>
           <tr id="ETRow"><td>4</td>  <td id="ETData">((F32) 48 * 0.3)</td></tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputCurrentReference"><Parameter SymbolName="LastSubIndex" Index="0x2065" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentReference" Index="0x2065" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="mA"><Description><![CDATA[
       
        Current Reference for Open Drain Output 1..N. This also acts as the Hold Current when using the output in Current mode with PullTime > 0.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">350 </td></tr>
          <tr id="ETRow"><td>2</td>  <td id="ETData">350 </td></tr>
           <tr id="ETRow"><td>3</td>  <td id="ETData">350 </td></tr>
           <tr id="ETRow"><td>4</td>  <td id="ETData">350 </td></tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputCurrentPgain"><Parameter SymbolName="LastSubIndex" Index="0x2066" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Pgain" Index="0x2066" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="100" Factor="1" Unit="-"><Description><![CDATA[
       
        Pgain for Open Drain Output 1..N.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputCurrentIgain"><Parameter SymbolName="LastSubIndex" Index="0x2067" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Igain" Index="0x2067" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="100" Factor="1" Unit="-"><Description><![CDATA[
       
        Igain for Open Drain Output 1..N.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputDitheringCurrentFrequency"><Parameter SymbolName="LastSubIndex" Index="0x2068" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="DitherFrequency" Index="0x2068" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="250" DefaultValue="0" Factor="1" Unit="Hz"><Description><![CDATA[
       
        Dithering Frequency for Open Drain Output 1..N.<br/>
        Frequency with which the Dithering Amplitude will be added to and alternately subtracted from the Current Reference.
        Duty cycle 50%. Setting DitherFrequency to 0 turns dithering off.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputDitheringCurrentAmplitude"><Parameter SymbolName="LastSubIndex" Index="0x2069" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="DitheringCurrentAmplitude" Index="0x2069" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="20" Factor="1" Unit="mA"><Description><![CDATA[
       
        Dithering Current Amplitude for Open Drain Output 1..N.<br/>
        Dithering Current Amplitude added and subtracted to Current Reference with Dithering Frequency.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputCurrent"><Parameter SymbolName="LastSubIndex" Index="0x206A" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="Current" Index="0x206A" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="mA"><Description><![CDATA[
       
        Current through Open Drain Output 1..N.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputPWMLevel"><Parameter SymbolName="LastSubIndex" Index="0x206B" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PWMLevel" Index="0x206B" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        PWM Level for Open Drain Output 1..N.<br/>
        Shows the compare value as set in hardware of MCU. If Open Drain is in
        Manual PWM control mode the PWMLevel can be set by writing to this subindex.
        Also, in Manual PWM control mode, if output is off then the desired PWM level is read
        back instead of the hardware register value (that shows 0 if the output is off).
        See <a href="#OpenDrainOutputPeriod.Period"/>OpenDrainOutputPeriod.Period</a> for maximum level.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="OpenDrainOutputNotConnectedLevel"><Parameter SymbolName="LastSubIndex" Index="0x206C" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="NotConnectedLevel" Index="0x206C" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="2500" Factor="1" Unit="mA"><Description><![CDATA[
       
        Not Connected Level for Open Drain Output 1..N.<br/>
        Current limit in mA. If measured current is below this for 200ms it will set the NotConnectedCh&lt;x&gt; event. <br/>
        Set to 0 to disable this check.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">0</td></tr>
         <tr id="ETRow"><td>2</td>  <td id="ETData">0</td></tr>
         <tr id="ETRow"><td>3</td>  <td id="ETData">0</td></tr>
         <tr id="ETRow"><td>4</td>  <td id="ETData">0</td></tr>
         <tr id="ETRow"><td>5</td>  <td id="ETData">100</td></tr>
         <tr id="ETRow"><td>6</td>  <td id="ETData">100</td></tr>
         <tr id="ETRow"><td>7</td>  <td id="ETData">100</td></tr>
         <tr id="ETRow"><td>8</td>  <td id="ETData">100</td></tr>
         <tr id="ETRow"><td>9</td>  <td id="ETData">100</td></tr>
        </table>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputPeakCurrentLevel"><Parameter SymbolName="LastSubIndex" Index="0x206D" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PeakCurrentLevel" Index="0x206D" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="2500" Factor="1" Unit="mA"><Description><![CDATA[
       
        Peak Current Level Open Drain Output 1..N.<br/>
        Current limit in mA. If measured current is above this for 16ms it will set the HighCurrentCh&lt;x&gt; event. <br/>
        If set to 0 the hardware limit will apply.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">1500</td></tr>
         <tr id="ETRow"><td>2</td>  <td id="ETData">1500</td></tr>
         <tr id="ETRow"><td>3</td>  <td id="ETData">1250</td></tr>
         <tr id="ETRow"><td>4</td>  <td id="ETData">1250</td></tr>
         <tr id="ETRow"><td>5</td>  <td id="ETData">1700</td></tr>
         <tr id="ETRow"><td>6</td>  <td id="ETData">1700</td></tr>
         <tr id="ETRow"><td>7</td>  <td id="ETData">1700</td></tr>
         <tr id="ETRow"><td>8</td>  <td id="ETData">500</td></tr>
         <tr id="ETRow"><td>9</td>  <td id="ETData">2500</td></tr>
        </table>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputOverloadCurrentLevel"><Parameter SymbolName="LastSubIndex" Index="0x206E" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="OverloadCurrentLevel" Index="0x206E" SubIndex="1" ObjectType="ARRAY" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1500" Factor="1" Unit="mA"><Description><![CDATA[
       
        Overload Current Level Open Drain Output 1..N.<br/>
        Current limit in mA. If measured current is above this for 10s it will set the HighCurrentCh&lt;x&gt; event.<br/>
        If set to 0 the hardware limit will apply.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">700</td></tr>
         <tr id="ETRow"><td>2</td>  <td id="ETData">1500</td></tr>
         <tr id="ETRow"><td>3</td>  <td id="ETData">1000</td></tr>
         <tr id="ETRow"><td>4</td>  <td id="ETData">1000</td></tr>
         <tr id="ETRow"><td>5</td>  <td id="ETData">1100</td></tr>
         <tr id="ETRow"><td>6</td>  <td id="ETData">1100</td></tr>
         <tr id="ETRow"><td>7</td>  <td id="ETData">1100</td></tr>
         <tr id="ETRow"><td>8</td>  <td id="ETData">300</td></tr>
         <tr id="ETRow"><td>9</td>  <td id="ETData">1000</td></tr>
        </table>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="OpenDrainOutputPullCurrent"><Parameter SymbolName="LastSubIndex" Index="0x206F" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PullCurrent" Index="0x206F" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="mA"><Description><![CDATA[
       
        Current Reference for Pull Current for Open Drain Output 1..N.
        It is used as initial current reference used for a time as specified by OpenDrainOutputPullTime.PullTime from the moment it is enabled.
        When PullTime has passed the OpenDrainOutputCurrentReference.CurrentReference is used as the main current reference until disabled.
       
      ]]></Description><DefaultValue><![CDATA[
       
        <table id="ET">
         <tr id="ETHead"><th>Sub Index</th><th id="ETHead">Value</th></tr>
         <tr id="ETRow"><td>1</td>  <td id="ETData">350 </td></tr>
          <tr id="ETRow"><td>2</td>  <td id="ETData">350 </td></tr>
           <tr id="ETRow"><td>3</td>  <td id="ETData">350 </td></tr>
           <tr id="ETRow"><td>4</td>  <td id="ETData">350 </td></tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="PmMotorParameters"><Parameter SymbolName="LastSubIndex" Index="0x2070" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PllPGain" Index="0x2070" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Proportional gain used in the PLL (Phase Locked Loop) filtering of the stator
        angle (4096 = 1). <br/><br/>
        The PLL filter serves the purpose of smoothing
        out bad feedback signals without introducing delay.<br/><br/>
        If PllPgain is set to zero, Pll filtering of StatorAngle is disabled,
        i.e. StatorAngle = StatorAngleUnfiltered and
        DeltaStatorAngle  = DeltaStatorAngleUnfiltered.
       
      ]]></Description></Parameter><Parameter SymbolName="PllIGain" Index="0x2070" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Integral gain used in the PLL filtering of the stator angle (4096 = 1).
       
      ]]></Description></Parameter><Parameter SymbolName="PllLimOutMax" Index="0x2070" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Max output from the PLL filtering of the stator angle, i.e. max value
        of DeltaStatorAngle16 (0x2071:17).
       
      ]]></Description></Parameter></Group>

<Group SymbolName="InductionMotorParameters"><Parameter SymbolName="LastSubIndex" Index="0x2071" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="SlipSpeed" Index="0x2071" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Difference between electrical rotor speed and stator speed. <br/>
        [1 => 4000 / 2^16 = 0.061 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="ZeroSpeedSlipGain" Index="0x2071" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The feed forward gain in the slip speed regulator. The feed forward term is Iq*ZeroSpeedSlipGain.<br/>
        [1 = 0.0000828 rad/s/ARMS or 0.0000132 Hz/ARMS]
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedVoltageRatio" Index="0x2071" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="" MaximumValue="" Factor="1"><Description><![CDATA[
       
        The assumed ratio between speed and modulation below OpenLoopModulationLevelDefault.
       
      ]]></Description></Parameter><Parameter SymbolName="DeltaSensorAngleFilterShiftSteps" Index="0x2071" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="2" Factor="1"><Description><![CDATA[
       
        Filter constant for sensor angle filter </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="ProtectFilterShiftSteps" Index="0x2071" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="4" Factor="1"><Description><![CDATA[
       
        Filter constant to set highest frequency were slip finder is active </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="FluxFinderFilterShiftSteps" Index="0x2071" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="15" Factor="1"><Description><![CDATA[
       
        Filter constant to set control frequency for slip finder regulator </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="LowFreqFluxFinderGain" Index="0x2071" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="400" Factor="1"><Description><![CDATA[
       
        Low frequency gain for slip regulator.
       
      ]]></Description></Parameter><Parameter SymbolName="HighFreqFluxFinderGain" Index="0x2071" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="200" Factor="1"><Description><![CDATA[
       
        High frequency gain for slip regulator.
       
      ]]></Description></Parameter><Parameter SymbolName="DeltaSensorAngleFiltered16" Index="0x2071" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Debug: Filtered sensor increment angle low resolution </br>
        Number of SensorAngle16 increment of per 4 kHz execution.</br>
        [1 => 4000 / 2^16 = 0.061 Hz]
       
      ]]></Description></Parameter><Parameter SymbolName="OpenLoopModulationLevel" Index="0x2071" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32" DefaultValue="3000" Factor="1"><Description><![CDATA[
       
        Lower modulation level when the dq plane starts to be corrected based on back EMF in d-direction.
       
      ]]></Description></Parameter><Parameter SymbolName="ClosedLoopModulationLevel" Index="0x2071" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="4000" Factor="1"><Description><![CDATA[
       
        Upper modulation level when the dq plane is fully corrected based on back EMF in d-direction.
       
      ]]></Description></Parameter><Parameter SymbolName="EdSlipSpeed" Index="0x2071" SubIndex="18" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The fluxfinder (to find rotor flux) part of slip speed.<br/>
        [1 => 4000 / 2^16 = 0.061 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="ExpectedSlipSpeed" Index="0x2071" SubIndex="19" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The feed forward (to find rotor flux) part of slip speed.<br/>
        [1 => 4000 / 2^16 = 0.061 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="LowFrequencyPart" Index="0x2071" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Debug: Low frequency part of the flux finder regulator output </br></br>
        [100 => 100 * 4096 * 4000 / 2^32 = 0.38 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="HighFrequencyPart" Index="0x2071" SubIndex="21" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Debug: High frequency part of the flux finder regulator output</br></br>
        [100 => 100 * 4096 * 4000 / 2^32 = 0.38 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="MaxAcceptableTimeWithSlipInWrongDirection" Index="0x2071" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="100" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The max acceptable time with slip in opposite direction to expected slip.<br/>
        The monitoring of slip in wrong direction is disabled by writing zero.<br/>
        [1 => 2 ms]
       
      ]]></Description></Parameter><Parameter SymbolName="SlipSpeedInWrongDirectionCheckLevel" Index="0x2071" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="30" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Above this level of SlipSpeed (electrical) SlipInWrongDirection is checked. <br/>
        [80 => 80 * 4000 / 2^16 = 4.9 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="TimeWithSlipInWrongDirection" Index="0x2071" SubIndex="24" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Debug: The time SlipSpeed has wrong sign.  </br>
        [1 => 2 ms]
       
      ]]></Description></Parameter><Parameter SymbolName="SlipSpeedHigh" Index="0x2071" SubIndex="25" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="130" Factor="1"><Description><![CDATA[
       
        The stator slip frequency were field weakening regulator shall anti wind-up.</br></br>
        [100 => 100 * 4096 * 4000 / 2^32 = 0.38 Hz electrical]
       
      ]]></Description></Parameter><Parameter SymbolName="LongestTimeWithSlipInWrongDirection" Index="0x2071" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1"><Description><![CDATA[
       
        The longets time with unexpected slip since default parameters was set.</br>
        [1 equals 2 ms]
       
      ]]></Description></Parameter><Parameter SymbolName="HighZeroSpeedSlipToleranceFactor" Index="0x2071" SubIndex="27" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="4" Factor="1" Unit="see Description"><Description><![CDATA[
       
        This is the number of times bigger the SlipSpeed must be compared to
        ExpectedSlipSpeed to trig the error TooHighZeroSpeedSlip.
       
      ]]></Description></Parameter><Parameter SymbolName="LongestTimeWithTooHighZeroSpeedSlip" Index="0x2071" SubIndex="28" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1"><Description><![CDATA[
       
        The longets time with to high slip at zero sensor speed since default parameters was set.</br>
        [1 equals 2 ms]
       
      ]]></Description></Parameter><Parameter SymbolName="MaxAcceptableTimeWithHighZeroSpeedSlip" Index="0x2071" SubIndex="29" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="50" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The max acceptable time with slip at very low speed that is bigger than
        (ExpectedSlipSpeed * SlipSpeedInWrongDirectionCheckLevel).<br/>
        [1 => 2 ms]
       
      ]]></Description></Parameter></Group>

<Group SymbolName="CurrentController"><Parameter SymbolName="LastSubIndex" Index="0x2072" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PgainDpart_CurrentController" Index="0x2072" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Proportional gain in the PI-parts of the current controller in the d-direction of the motor.<br/>
        (256 = 1)<br/>
        The gain used internally is divided by 2 or 4 when switching at 2 and 1 kHz respectively.
       
      ]]></Description></Parameter><Parameter SymbolName="IgainDpart_CurrentController" Index="0x2072" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Integral gain in the PI-parts of the current controller in the d-direction of the motor.<br/>
        (256 = 1)<br/>
        The gain used internally is divided by 2 or 4 when switching at 2 and 1 kHz respectively.
       
      ]]></Description></Parameter><Parameter SymbolName="PgainQpart_CurrentController" Index="0x2072" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Proportional gain in the PI-parts of the current controller in the q-direction of the motor.<br/>
        (256 = 1)<br/>
        The gain used internally is divided by 2 or 4 when switching at 2 and 1 kHz respectively.
       
      ]]></Description></Parameter><Parameter SymbolName="IgainQpart_CurrentController" Index="0x2072" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Integral gain in the PI-parts of the current controller in the q-direction of the motor.<br/>
        (256 = 1)<br/>
        The gain used internally is divided by 2 or 4 when switching at 2 and 1 kHz respectively.
       
      ]]></Description></Parameter><Parameter SymbolName="RegdIpart" Index="0x2072" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Integral part of the current controller in the d-direction of the motor.
       
      ]]></Description></Parameter><Parameter SymbolName="RegqIpart" Index="0x2072" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Integral part of the current controller in the q-direction of the motor.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxIdRefChange" Index="0x2072" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1000" Factor="1" Unit="dApeak/250us"><Description><![CDATA[
       
        Maximum allowed step in IdRef from one sample to another. This is used
        to ramp the IdRef that is used in the regulator.
        Disable the ramp by set the value to 0.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxIqRefChange" Index="0x2072" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1000" Factor="1" Unit="dApeak/250us"><Description><![CDATA[
       
        Maximum allowed step in IqRef from one sample to another. This is used
        to ramp the IqRef that is used in the regulator.
        Disable the ramp by set the value to 0.
       
      ]]></Description></Parameter><Parameter SymbolName="CrossCouplingMode" Index="0x2072" SubIndex="14" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="7" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        This sets the current cross coupling calculation method used.
        INDUCTANCE_ACTUAL_CURRENT: Make use of the actual current mesurements and uses L (Ld and Lq).
        INDUCTANCE_REFERENS_CURRENT: Make use of the referense current mesurements and uses L (Ld and Lq).
        INDUCTANCE_AVERAGE_CURRENT: Make use of the avagrage ((act+ref)/2) current mesurements and uses L (Ld and Lq).
        NOMINAL_DQFLUX_ACTUAL_CURRENT: Make use of the actual current mesurements and interpolates values from DQ flux table.
        NOMINAL_DQFLUX_REFERENS_CURRENT: Make use of the referense current mesurements and interpolates values from DQ flux table.
        NOMINAL_DQFLUX_AVERAGE_CURRENT: Make use of the avagrage ((act+ref)/2) current mesurements and interpolates values from DQ flux table.
        ACTUAL_DQFLUX:  Will not use L in cross coupling calculation
        NO_CROSSCOUPLING:  Don't use cross coupling at all, set decoupling to zero
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="INDUCTANCE_ACTUAL_CURRENT"/>
        <ValueFieldDef Value="1" Description="INDUCTANCE_REFERENS_CURRENT"/>
        <ValueFieldDef Value="2" Description="INDUCTANCE_AVERAGE_CURRENT"/>
        <ValueFieldDef Value="3" Description="NOMINAL_DQFLUX_ACTUAL_CURRENT"/>
        <ValueFieldDef Value="4" Description="NOMINAL_DQFLUX_REFERENS_CURRENT"/>
        <ValueFieldDef Value="5" Description="NOMINAL_DQFLUX_AVERAGE_CURRENT"/>
        <ValueFieldDef Value="6" Description="ACTUAL_DQFLUX"/>
        <ValueFieldDef Value="7" Description="NO_CROSSCOUPLING"/>
      </ValueFieldDefs></Parameter></Group>

<Group SymbolName="MotorMeasurements"><Parameter SymbolName="LastSubIndex" Index="0x2073" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="RmsMotorCurrent" Index="0x2073" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Scalar sum of measured current &amp; magnetisation current = &radic;<span style="text-decoration:overline;">
        Id&sup2; + Iq&sup2;</span>. Filtered value.
       
      ]]></Description></Parameter><Parameter SymbolName="DcBusCurrent" Index="0x2073" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3325" MaximumValue="3325" DefaultValue="-" Factor="1" Unit="Adc"><Description><![CDATA[
       
        Estimated and filtered dc bus current
       
      ]]></Description></Parameter><Parameter SymbolName="DcBusPower" Index="0x2073" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-13621" MaximumValue="13620" DefaultValue="-" Factor="10" Unit="W"><Description><![CDATA[
       
        Estimated and filtered DC power.
       
      ]]></Description></Parameter><Parameter SymbolName="FluxFilterShiftSteps" Index="0x2073" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="4" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Filter time constant when calculating Flux. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="UPeak" Index="0x2073" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Calculated UPeak. </br></br> 16384 = 48.00 / &radic;<span style="text-decoration:overline;">3</span>
       
      ]]></Description></Parameter><Parameter SymbolName="Rmotor" Index="0x2073" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="21649" Factor="100" Unit="uOhm"><Description><![CDATA[
       
        Motor resistance, i.e. Rstator + Rrotor, in phase-to-neutral.
        
      ]]></Description></Parameter><Parameter SymbolName="Ld" Index="0x2073" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="3445" Factor="1" Unit="uH"><Description><![CDATA[
       
        Leakage inductance in d-direction.
        
      ]]></Description></Parameter><Parameter SymbolName="Lq" Index="0x2073" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="3445" Factor="1" Unit="uH"><Description><![CDATA[
       
        Leakage inductance in q-direction.
        
      ]]></Description></Parameter><Parameter SymbolName="RotorFluxCalc" Index="0x2073" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="1763" DefaultValue="0" Factor="0.1" Unit="mVs"><Description><![CDATA[
       
        Filtered rotor flux calculated from internal voltages and currents.
       
      ]]></Description></Parameter><Parameter SymbolName="Ed" Index="0x2073" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Calculated back EMF in d-direction.
        
      ]]></Description></Parameter><Parameter SymbolName="RmsCurrentFilterShiftSteps" Index="0x2073" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="2" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Time constant for CurrentAngle filter </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="DcBusPowerFilterShiftSteps" Index="0x2073" SubIndex="12" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="2" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Time constant for DcBusPower. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="Ldq" Index="0x2073" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="3445" Factor="1" Unit="uH"><Description><![CDATA[
       
        Inductance in both d and q-direction, if they are to be same.
       
      ]]></Description></Parameter><Parameter SymbolName="wIqLd" Index="0x2073" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The wIqLq part of Ed calculation
       
      ]]></Description></Parameter><Parameter SymbolName="RmotorTempComp" Index="0x2073" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="21649" DefaultValue="-" Factor="100" Unit="uOhm"><Description><![CDATA[
       
        <p>Winding temperature compensated motor resistance.</p>
        <p>If no temperature reading is possible, a default value of 100
        &deg;C is assumed.</p>
        <p>Writing to RmotorTempComp is an alternative way to write 'Rmotor'. RmotorTempComp consider the present motor temperature when RmotorTempComp is written, to calculate and write the corresponding reference temperature resistance 'Rmotor'.</p>
        
      ]]></Description></Parameter><Parameter SymbolName="AutoTuneState" Index="0x2073" SubIndex="16" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" Factor="1" Unit="see Description"><Description><![CDATA[
       
        State of the Auto tuning of inductance and resistance.  <br/><br/>
        0:  Auto tuning inactive. Always start in this state. Write 1 in this state to autotune in one sequence write 2 to do it stepwise.  <br/><br/>
        1:  One sequence autotuning.
        2:  Stepwise autotuning.
        3:  DriveTool enables powerstage. Auto tuning initialization has been done. Configure transient recorder first to see the result (for exampel Id (0x2077:2), UdRef (0x2079:2)  <br/><br/>
        4:  Sweeping of voltage is performed to measure stator resistance and verify deadband. Id shall be proportional to Ud when looking in trace.  <br/><br/>
        5:  Waiting for transient recorder to finish.  <br/><br/>
        6:  Waiting for user to write 7 to find voltage step if stepwise autotune is selected.  <br/><br/>
        10: Waiting for user to write 11 to find parameters if stepwise autotune is selected.  <br/><br/>
        18: Waiting for user to write 19 to proceed with current step response if stepwise autotune is selected. Tuning of inductance, resistanse current control P and I gains is ready.  <br/><br/>
        21: Performs current step response and start the Transient recorder. Software disable powerstage after one second and return to State 0.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="VoltageStep" Index="0x2073" SubIndex="17" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The voltage step used for auto tuning of inductance and resistance.
        
      ]]></Description></Parameter><Parameter SymbolName="TransRecTrigStart" Index="0x2073" SubIndex="18" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Setting the 4kHz start point of the transient recorder when performing auto tuning.  <br/><br/>
        0:    Start sampling from beginning when finding VoltageStep.  <br/><br/>
        1000: Start sampling when extraction of inductance and resistance begins.  <br/><br/>
        1095: Start sampling five samples before extraction of inductance and resistance is finished.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="TunedResistance" Index="0x2073" SubIndex="19" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="21649" Factor="100" Unit="uOhm"><Description><![CDATA[
       
        The resulting resistance from auto tuning.
        
      ]]></Description></Parameter><Parameter SymbolName="TunedInductance" Index="0x2073" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="3445" Factor="1" Unit="uH"><Description><![CDATA[
       
        The resulting inductance from auto tuning.
        
      ]]></Description></Parameter><Parameter SymbolName="InstantInductance" Index="0x2073" SubIndex="21" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" Factor="1"><Description><![CDATA[
       
        The instant inductance each sample from auto tuning.
        
      ]]></Description></Parameter><Parameter SymbolName="TunedResistanceInternalScaling" Index="0x2073" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description/></Parameter><Parameter SymbolName="TunedInductanceInternalScaling" Index="0x2073" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description/></Parameter><Parameter SymbolName="UnfilteredDcBusCurrent" Index="0x2073" SubIndex="24" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-3325" MaximumValue="3325" DefaultValue="-" Factor="1" Unit="Adc"><Description><![CDATA[
       
        Unfiltered dc bus current
       
      ]]></Description></Parameter><Parameter SymbolName="SaturationIndicator" Index="0x2073" SubIndex="26" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The instant value of inductance and resistance during autotuning.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="StatorResistance" Index="0x2073" SubIndex="29" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="21649" DefaultValue="-" Factor="100" Unit="uOhm"><Description><![CDATA[
       
        The stator resistanse calculated with slow changing voltage.
        
      ]]></Description></Parameter><Parameter SymbolName="RampVoltageSlope" Index="0x2073" SubIndex="30" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The rate of voltage increase/decrease when ramping voltage to se deadband and voltage current correlation  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="Eq" Index="0x2073" SubIndex="31" ObjectType="VAR" DataType="INTEGER16" Visibility="Service" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Calculated back EMF in q-direction.
        
      ]]></Description></Parameter><Parameter SymbolName="DrivingVoltage" Index="0x2073" SubIndex="32" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The instant value of voltage that changed current in Autotuning.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="AutoTuneCurrentGradient" Index="0x2073" SubIndex="36" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
        The filtered current gradient.
        
      ]]></Description></Parameter><Parameter SymbolName="DcBusEnergy" Index="0x2073" SubIndex="37" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Dc bus energy accumulated from dc bus power in Q31 format.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="NormDcBusEnergy" Index="0x2073" SubIndex="38" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Dc bus energy sampled at start of autotuning to normalize DcBusEnergyPerCycle.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="DcBusEnergyLowSpeed" Index="0x2073" SubIndex="39" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The lower speed in the speed intervall were Dc bus energy is calculated.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="DcBusEnergyHighSpeed" Index="0x2073" SubIndex="40" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The higher speed in the speed intervall were Dc bus energy is calculated.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="DcBusEnergyTimer" Index="0x2073" SubIndex="41" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="rw" MinimumValue="-2147483648" MaximumValue="2147483647" Factor="1" Unit="see Description"><Description><![CDATA[
       
        The countdown time in the speed intervall were Dc bus energy is calculated.  <br/><br/>
        If the timer is set different from 0 the measurement is armed.  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="TurnPointLowSpeed" Index="0x2073" SubIndex="42" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="DcBusEnergyPerCycle" Index="0x2073" SubIndex="43" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="CycleTime" Index="0x2073" SubIndex="44" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="EdSlipSpeedMaxRipple" Index="0x2073" SubIndex="45" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleGainChangeStep" Index="0x2073" SubIndex="46" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleGainAndDcBusEnergyPerCycle" Index="0x2073" SubIndex="47" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="CurrentAngleGainAndCycleTime" Index="0x2073" SubIndex="48" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="MaxSlipSpeedAndZeroSpeedSlipGain" Index="0x2073" SubIndex="49" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="TurnPointHighSpeed" Index="0x2073" SubIndex="50" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       
        -  <br/><br/>
        
      ]]></Description></Parameter><Parameter SymbolName="EdFilterShiftSteps" Index="0x2073" SubIndex="51" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="15" DefaultValue="2" Factor="1" Unit="see Description"><Description><![CDATA[
       
        Filter time constant for calculated ac voltage in d-direction. </br>
        Time constant = 2^(ShiftSteps - 12) [s] </br>
        If ShiftSteps = 0  filter is disabled </br>
        If ShiftSteps = 1  then time constant = 0.5 ms </br>
        If ShiftSteps = 15 then time constant = 8 s
       
      ]]></Description></Parameter><Parameter SymbolName="InductanceTableMaxCurrent" Index="0x2073" SubIndex="52" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       Defines the current range for the inductance tables.
       The last points are given at this current.
      ]]></Description></Parameter><Parameter SymbolName="MinDeltaStatorAngleForFluxCalc" Index="0x2073" SubIndex="53" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="see Description"><Description><![CDATA[
       Only calculate a rotor flux value above this stator frequency. 819 = 50 Hz.
      ]]></Description></Parameter><Parameter SymbolName="CanSignalDcCurrentFilterGain" Index="0x2073" SubIndex="54" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="300" Factor="1" Unit="-"><Description><![CDATA[
        
        First order filtering coefficient for the separately filtered DC current signal for CAN.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalRmsMotorCurrentFilterGain" Index="0x2073" SubIndex="55" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="300" Factor="1" Unit="-"><Description><![CDATA[
        
        First order filtering coefficient for the separately filtered AC current signal for CAN.<br/><br/>
        FilteredValue = FilteredValue - FilterGain / 16384 * (RawValue - FilteredValue) <br/>
        <i>f<sub>c</sub></i> = (FilterGain * 4000) / ((16384 - FilterGain) * 2 * &pi;) <br/>
        &tau; = (16384 - FilterGain) / (FilterGain * 4000)
        <ul>
         <li>FilterGain = 1, means slowest possible filter</li>
         <li>FilterGain = 16384, means no filtering</li>
         <li>FilterGain = 0, means filter froze on last output</li>
        </ul>
       
      ]]></Description></Parameter><Parameter SymbolName="CanSignalRmsMotorCurrent" Index="0x2073" SubIndex="56" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
        
        Scalar sum of measured current &amp; magnetisation current = &radic;<span style="text-decoration:overline;">
        Id&sup2; + Iq&sup2;</span>. Filtered value.
       
      ]]></Description></Parameter><Parameter SymbolName="OverCurrentLimit" Index="0x2073" SubIndex="57" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Custom over current trip level. <br/>
       Set to 0 to disable.
       
      ]]></Description></Parameter><Parameter SymbolName="OverCurrentSampleLimit" Index="0x2073" SubIndex="58" ObjectType="VAR" DataType="UNSIGNED16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="65535" DefaultValue="4" Factor="1" Unit="-"><Description><![CDATA[
       
       Number of consecutive over current samples in 4 kHz allowed before event is set.
       
      ]]></Description></Parameter><Parameter SymbolName="MotorCurrentUnfiltered" Index="0x2073" SubIndex="59" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="3276" DefaultValue="-" Factor="1" Unit="Apk"><Description><![CDATA[
       
        Scalar sum of measured current &amp; magnetisation current = &radic;<span style="text-decoration:overline;">
        Id&sup2; + Iq&sup2;</span>. Unfiltered value.
       
      ]]></Description></Parameter><Parameter SymbolName="UseTableForInductances" Index="0x2073" SubIndex="60" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1"><Description><![CDATA[
      
       Only valid when flux calcuation is set to 0 (Inductace).
       Configure if current dependent tables or single parameter shall be used to get Ld and Lq
       from Ld & Lq table </br>
       
      ]]></Description><ValueFieldDefs>
       <ValueFieldDef Value="0" Description="Use single parameters."/>
       <ValueFieldDef Value="1" Description="Use table"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="ActualDFlux" Index="0x2073" SubIndex="61" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1764" MaximumValue="1763" DefaultValue="-" Factor="0.1" Unit="mVs"><Description><![CDATA[
       
        Filtered rotor d-flux calculated from internal voltages and currents.
       
      ]]></Description></Parameter><Parameter SymbolName="ActualQFlux" Index="0x2073" SubIndex="62" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-1764" MaximumValue="1763" DefaultValue="-" Factor="0.1" Unit="mVs"><Description><![CDATA[
       
        Filtered rotor q-flux calculated from internal voltages and currents.
       
      ]]></Description></Parameter><Parameter SymbolName="FreezeRotorFluxAtLowSpeed" Index="0x2073" SubIndex="63" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1"><Description><![CDATA[
      
       Setting for using frozen flux or table flux at low speed. </br>
       Only applicable if FluxCalculationMethod is 0. That is when calculated magnet flux is used.  </br>
       
      ]]></Description><ValueFieldDefs>
       <ValueFieldDef Value="0" Description="Rotorflux is calculated from NominalRotorFlux and FluxModificationFactor."/>
       <ValueFieldDef Value="1" Description="Last calculated rotorflux is used below MinDeltaStatorAngleForFluxCalc. NominalRotorFlux is used at start-up"/>
      </ValueFieldDefs></Parameter></Group>

<Group SymbolName="SpwmParameters"><Parameter SymbolName="LastSubIndex" Index="0x2074" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="ActualPwmFrequency" Index="0x2074" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="ro" MinimumValue="1" MaximumValue="16" DefaultValue="-" Factor="1" Unit="kHz"><Description><![CDATA[
       
        Actual SPWM Switching Frequency<br/>
        1, 2, 4, 8, 12 or 16 kHz
       
      ]]></Description></Parameter><Parameter SymbolName="DeadBandCompensationTime" Index="0x2074" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" DefaultValue="1000" Factor="1" Unit="ns" WarningRemark="Internal Use Only"/><Parameter SymbolName="AdjustedDeadBandCompTime" Index="0x2074" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="ns" WarningRemark="Internal Use Only"/><Parameter SymbolName="EnableDoubleFlank" Index="0x2074" SubIndex="10" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="1" Factor="1" WarningRemark="Internal Use Only"/><Parameter SymbolName="MotorCurrentLowLevel" Index="0x2074" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="180" Factor="1" Unit="Arms"><Description><![CDATA[
       
         Low motor current when switching frequency can automatically be changed.
       
      ]]></Description></Parameter><Parameter SymbolName="MotorCurrentMidLevel" Index="0x2074" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="220" Factor="1" Unit="Arms"><Description><![CDATA[
       
         Medium motor current when switching frequency can automatically be changed.
       
      ]]></Description></Parameter><Parameter SymbolName="MotorCurrentHighLevel" Index="0x2074" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="280" Factor="1" Unit="Arms"><Description><![CDATA[
       
         High motor current when switching frequency can automatically be changed.
       
      ]]></Description></Parameter><Parameter SymbolName="MotorCurrentHysteresisLevel" Index="0x2074" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="10" Factor="1" Unit="Arms"><Description><![CDATA[
       
         Motor current hysteresis level when automatically changing switching frequency.
       
      ]]></Description></Parameter><Parameter SymbolName="ElecFreqLowLevel" Index="0x2074" SubIndex="17" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="19999" DefaultValue="120" Factor="0.1" Unit="Hz"><Description><![CDATA[
       
         Low electrical frequency when switching frequency can automatically be changed.
       
      ]]></Description></Parameter><Parameter SymbolName="ElecFreqMidLevel" Index="0x2074" SubIndex="18" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="19999" DefaultValue="250" Factor="0.1" Unit="Hz"><Description><![CDATA[
        
         Medium electrical frequency when switching frequency can automatically be changed.
       
      ]]></Description></Parameter><Parameter SymbolName="ElecFreqHighLevel" Index="0x2074" SubIndex="19" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="19999" DefaultValue="1000" Factor="0.1" Unit="Hz"><Description><![CDATA[
       
         High electrical frequency when switching frequency can automatically be changed.
       
      ]]></Description></Parameter><Parameter SymbolName="ElecFreqHysteresisLevel" Index="0x2074" SubIndex="20" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="19999" DefaultValue="40" Factor="0.1" Unit="Hz"><Description><![CDATA[
       
         Electrical frequency Hysteresis level when automatically changing switching.
       
      ]]></Description></Parameter><Parameter SymbolName="ActualPwmFrequencyZone" Index="0x2074" SubIndex="21" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="33" DefaultValue="-" Factor="1" Unit="kHz"><Description><![CDATA[
       
        Switching frequency zone depends on motor current and electrical frequency according to table below<br/><br/>
        <table id="ET">
          <tr id="ETRow">  <td></td>                       <td></td>             <th>ElecFreqLowLevel</th>             <td></td>                  <th>ElecFreqMidLevel</th>             <td></td>             <th>ElecFreqHighLevel</th>            <td></td></tr>
          <tr id="ETRow">  <td></td>                       <td>Zone03</td>       <td>            |              </td>  <td>Zone13</td>            <td>            |              </td>  <td>Zone23</td>       <td>            |              </td>  <td>Zone33</td></tr>
          <tr id="ETRow">  <th>MotorCurrentHighLevel</th>  <td>-----------</td>  <td>---------------------------</td>  <td>-----------</td>       <td>---------------------------</td>  <td>-----------</td>  <td>---------------------------</td>  <td>-----------</td></tr>
          <tr id="ETRow">  <td></td>                       <td>Zone02</td>       <td>            |              </td>  <td>Zone12</td>            <td>            |              </td>  <td>Zone22</td>       <td>            |              </td>  <td>Zone32</td></tr>
          <tr id="ETRow">  <th>MotorCurrentMidLevel</th>   <td>-----------</td>  <td>---------------------------</td>  <td>-----------</td>       <td>---------------------------</td>  <td>-----------</td>  <td>---------------------------</td>  <td>-----------</td></tr>
          <tr id="ETRow">  <td></td>                       <td>Zone01</td>       <td>            |              </td>  <td>Zone11</td>            <td>            |              </td>  <td>Zone21</td>       <td>            |              </td>  <td>Zone31</td></tr>
          <tr id="ETRow">  <th>MotorCurrentLowLevel</th>   <td>-----------</td>  <td>---------------------------</td>  <td>-----------</td>       <td>---------------------------</td>  <td>-----------</td>  <td>---------------------------</td>  <td>-----------</td></tr>
          <tr id="ETRow">  <td></td>                       <td>Zone00</td>       <td>            |              </td>  <td>Zone10</td>            <td>            |              </td>  <td>Zone20</td>       <td>            |              </td>  <td>Zone30</td></tr>
        </table> <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone00" Index="0x2074" SubIndex="23" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is below:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a>.<br/>
       and motor current is below:<br/>
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentLowLevel</a>.<br/>
        Actual SPWM Switching Frequency<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone01" Index="0x2074" SubIndex="24" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is below:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a> and
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone02" Index="0x2074" SubIndex="25" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is below:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a> and
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone03" Index="0x2074" SubIndex="26" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is below:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a>.<br/>
       and motor current is above:<br/>
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone10" Index="0x2074" SubIndex="27" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a> and
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a>.<br/>
       and motor current is below:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone11" Index="0x2074" SubIndex="28" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a> and
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a> and
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone12" Index="0x2074" SubIndex="29" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a> and
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a> and
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone13" Index="0x2074" SubIndex="30" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqLowLevel">ElecFreqLowLevel</a> and
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a>.<br/>
       and motor current is above:<br/>
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone20" Index="0x2074" SubIndex="31" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a> and
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is below:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone21" Index="0x2074" SubIndex="32" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a> and
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a> and
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone22" Index="0x2074" SubIndex="33" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a> and
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a> and
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone23" Index="0x2074" SubIndex="34" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is between:<br/>
       <a href="#SpwmParameters.ElecFreqMidLevel">ElecFreqMidLevel</a> and
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is above:<br/>
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone30" Index="0x2074" SubIndex="35" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is above:<br/>
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is below:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone31" Index="0x2074" SubIndex="36" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is above:<br/>
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentLowLevel">MotorCurrentLowLevel</a> and
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone32" Index="0x2074" SubIndex="37" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is above:<br/>
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
       and motor current is between:<br/>
       <a href="#SpwmParameters.MotorCurrentMidLevel">MotorCurrentMidLevel</a> and
       <a href="#SpwmParameters.MotorCurrentHighLevel">MotorCurrentHighLevel</a>.<br/>
        Valid values are  1, 2, 4, 8, 12 or 16
       
      ]]></Description></Parameter><Parameter SymbolName="PwmFrequencyInZone33" Index="0x2074" SubIndex="38" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="rw" MinimumValue="1" MaximumValue="16" DefaultValue="8" Factor="1" Unit="kHz"><Description><![CDATA[
       
       Motor switching frequency is set to the value of this parameter when electrical frequency is above:<br/>
       <a href="#SpwmParameters.ElecFreqHighLevel">ElecFreqHighLevel</a>.<br/>
