      <Module Name="Rtosmg"/>
    </Event>
        <Event Name="ClockFailure" EventId="1460u" CheckIn4Khz="FALSE" StoreInLog="TRUE" StoreFreezeFrame="TRUE">
      <Description><![CDATA[
        
        <b>Description</b><br/>
