      ]]></Description></Parameter><Parameter SymbolName="Ld" Index="0x2125" SubIndex="1" ObjectType="ARRAY" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="3445" DefaultValue="-" Factor="1" Unit="uH"><Description><![CDATA[
        Inductance for this table entry.
      ]]></Description></Parameter></Group>

