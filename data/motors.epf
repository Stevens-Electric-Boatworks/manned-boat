<Group SymbolName="MemoryAccessBank4"><Parameter SymbolName="LastSubIndex" Index="0x2254" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="MemoryAddress" Index="0x2254" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED32" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
        
          Set memory address to read from or write to.
        
      ]]></Description></Parameter><Parameter SymbolName="Value_S8" Index="0x2254" SubIndex="2" ObjectType="VAR" DataType="INTEGER8" Visibility="Internal" AccessType="ro" MinimumValue="-128" MaximumValue="127" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
        
          Read and write S8 at the specificed memory address.
        
      ]]></Description></Parameter><Parameter SymbolName="Value_S16" Index="0x2254" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
        
          Read and write S16 at the specificed memory address.
        
      ]]></Description></Parameter><Parameter SymbolName="Value_S32" Index="0x2254" SubIndex="4" ObjectType="VAR" DataType="INTEGER32" Visibility="Internal" AccessType="ro" MinimumValue="-2147483648" MaximumValue="2147483647" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
        
          Read and write S32 at the specificed memory address.
        
      ]]></Description></Parameter><Parameter SymbolName="Value_U8" Index="0x2254" SubIndex="5" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
        
          Read and write U8 at the specificed memory address.
        
      ]]></Description></Parameter><Parameter SymbolName="Value_U16" Index="0x2254" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Internal" AccessType="ro" MinimumValue="0" MaximumValue="65535" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
        
          Read and write U16 at the specificed memory address.
        
