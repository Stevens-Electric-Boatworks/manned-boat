                     <tr id="ETRow"> <td>4</td>  <td id="ETData">25</td></tr>
                    </table>
           </td>
         </tr>
          <tr id="ETRow"> <td>3</td>  <td id="ETData">
                    <table id="ET">
                     <tr id="ETHead"><th id="ETHead">SubIndex</th>  <th id="ETHead">Value</th>  </tr>
                     <tr id="ETRow"> <td>1</td>  <td id="ETData">2</td></tr>
                     <tr id="ETRow"> <td>2</td>  <td id="ETData">25</td></tr>
                     <tr id="ETRow"> <td>3</td>  <td id="ETData">25</td></tr>
                     <tr id="ETRow"> <td>4</td>  <td id="ETData">25</td></tr>
                    </table>
           </td>
         </tr>
        </table>
        <a href="#NOTE 1">See NOTE 1</a>
       
      ]]></DefaultValue></Parameter></Group>

<Group SymbolName="DcPowerLimit"><Parameter SymbolName="LastSubIndex" Index="0x2094" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="PosDcPowerLimit" Index="0x2094" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="13620" DefaultValue="-" Factor="10" Unit="W"><Description><![CDATA[
       
       Requested positive DC power limit.
       Please note that this is NOT saved to EEPROM.<br/>
       Function must be activated in
       <a href="#ApplicationSetupParameters.ApplicationSetupWord">ApplicationSetupWord</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="NegDcPowerLimit" Index="0x2094" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="13620" DefaultValue="-" Factor="10" Unit="W"><Description><![CDATA[
       
       Requested negative DC power limit.
       Please note that this is NOT saved to EEPROM.<br/>
       Function must be activated in
       <a href="#ApplicationSetupParameters.ApplicationSetupWord">ApplicationSetupWord</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="PosDcCurrentLimit" Index="0x2094" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="3325" DefaultValue="-/&gt;" Factor="1" Unit="Adc"><Description><![CDATA[
       
       Positive DC current limit.
       Please note that this is NOT saved to EEPROM.<br/>
       Function must be activated in
       <a href="#ApplicationSetupParameters.ApplicationSetupWord">ApplicationSetupWord</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="NegDcCurrentLimit" Index="0x2094" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="3325" DefaultValue="-" Factor="1" Unit="Adc"><Description><![CDATA[
       
       Negative DC current limit.
       Please note that this is NOT saved to EEPROM.<br/>
       Function must be activated in
       <a href="#ApplicationSetupParameters.ApplicationSetupWord">ApplicationSetupWord</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="PowerFilterGain" Index="0x2094" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="1" MaximumValue="16384" DefaultValue="2000" Factor="1"><Description><![CDATA[
       Filter gain for power limit. 16384 = no filtering.
      ]]></Description></Parameter><Parameter SymbolName="ResponseFactor" Index="0x2094" SubIndex="6" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="255" DefaultValue="220" Factor="1"><Description><![CDATA[
       Controls the response time when entering power limit.
       A value of 0 means fastest possible response.
       A higher value means a smoother transition in to power limit.
      ]]></Description></Parameter><Parameter SymbolName="AccCurrentLimitFromDcPowerOrDcCurrentLimit" Index="0x2094" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Motoring current limit. <br/>
       Result from conversion of AccDcPowerLimit to current.
       It will be the lowest value of AccCurrentLimitDueToDcPowerLimit and AccCurrentLimitDueToDcCurrentLimit
       
      ]]></Description></Parameter><Parameter SymbolName="BrakeCurrentLimitFromDcPowerOrDcCurrentLimit" Index="0x2094" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Regenerative current limit. <br/>
       Result from conversion of BrakeDcPowerLimit to current.
       It will be the lowest value of BrakeCurrentLimitDueToDcPowerLimit and BrakeCurrentLimitDueToDcCurrentLimit.
       
      ]]></Description></Parameter><Parameter SymbolName="CalculatedTorque" Index="0x2094" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1"><Description/></Parameter><Parameter SymbolName="AccCurrentLimitDueToDcPowerLimit" Index="0x2094" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Result of AccCurrentLimitation calculation using PosDcPowerLimit.
       
      ]]></Description></Parameter><Parameter SymbolName="BrakeCurrentLimitDueToDcPowerLimit" Index="0x2094" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Result of BrakeCurrentLimitation calculation using NegDcPowerLimit.
       
      ]]></Description></Parameter><Parameter SymbolName="AccCurrentLimitDueToDcCurrentLimit" Index="0x2094" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Result of AccCurrentLimitation calculation using PosDcCurrentLimit.
       
      ]]></Description></Parameter><Parameter SymbolName="BrakeCurrentLimitDueToDcCurrentLimit" Index="0x2094" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Result of BrakeCurrentLimitation calculation using NegDcCurrentLimit.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="CurrentLimit"><Parameter SymbolName="LastSubIndex" Index="0x2095" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxAccCurrent" Index="0x2095" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="wo" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Sets both Forward and Reverse Max Acceleration Currents to the same value.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxBrakeCurrent" Index="0x2095" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="wo" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Sets both Forward and Reverse Max Brake Currents to the same value.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentChange" Index="0x2095" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1000" Factor="1" Unit="deciArms / ms"><Description><![CDATA[
       
       The maximum allowed change during 1 ms (i.e. derivate) of the Reference
       Current that is allowed. A too high derivate may for
       example introduce noice in the gear.
       Due to truncation it does not get exacly requested behaviour when
       selecting a value between 1-4.
       If set to 0, no ramp limitation of Current.
       <b>NOTE! The unit is only valid if EXTERNAL_CURRENT_REPRESENTATION = Arms.</b>
       
      ]]></Description></Parameter><Parameter SymbolName="ForwardMaxAccCurrent" Index="0x2095" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max acceleration current in forward direction. This limit can be reduced due to for example high temperature, low DC Bus Voltage etc. <br/>
       Instantaneously available current in 2095h:9-10.
       
      ]]></Description></Parameter><Parameter SymbolName="ReverseMaxAccCurrent" Index="0x2095" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max acceleration current in reverse direction. This limit can be reduced due to for example high temperature, high DC Bus Voltage etc. <br/>
       Instantaneously available current in 2095h:9-10.
       
      ]]></Description></Parameter><Parameter SymbolName="ForwardMaxBrakeCurrent" Index="0x2095" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max braking current in forward direction. This limit can be reduced due to for example high temperature, low DC Bus Voltage etc. <br/>
       Instantaneously available current in 2095h:9-10.
       
      ]]></Description></Parameter><Parameter SymbolName="ReverseMaxBrakeCurrent" Index="0x2095" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max braking current in reverse direction. This limit can be reduced due to for example high temperature, low DC Bus Voltage etc. <br/>
       Instantaneously available current in 2095h:9-10.
       
      ]]></Description></Parameter><Parameter SymbolName="AbilityAccelerationCurrent" Index="0x2095" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Will be lower than 2095h:5-6 if any reduction is active. <br/>
       Reductions will be active due to physical reasons, e.g. high or low voltage,
       high or low temperature or high speed. <br/>
       Any active reduction should be signaled as a Warning in <a href="#Diagnostic">Diagnostic, ExtendedWarnings</a> <br/>
       Available acceleration current is always the minimum of the AbilityAccelerationCurrent and AccCurrentLimit (2095h:15).
       
      ]]></Description></Parameter><Parameter SymbolName="AbilityBrakeCurrent" Index="0x2095" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Will be lower than 2095h:7-8 if any reduction is active. <br/>
       Reductions will be active due to physical reasons, e.g. high or low voltage,
       high or low temperature or high speed. <br/>
       Any active reduction should be signaled as a Warning in <a href="#Diagnostic">Diagnostic, ExtendedWarnings</a> <br/>
       Available brake current is always the minimum of the AbilityBrakeCurrent and BrakeCurrentLimit (2095h:16).
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyHighSpeedStartLevel" Index="0x2095" SubIndex="11" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="5000" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Linear over speed protection level. Rollback of current starts at ModeratelyHighSpeedStartLevel
       and ends at ModeratelyHighSpeedEndLevel. Only used for accelerating current.
       Setting the parameter to 0 disables the function.
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyHighSpeedEndLevel" Index="0x2095" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="5250" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       SeeModeratelyHighSpeedStartLevel.
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyLowSpeedStartLevel" Index="0x2095" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       <p>Linear low speed protection. </p>
       <p>Braking current starts to be reduced when speed is less than
       ModeratelyLowSpeedStartLevel and 0 current is reached at ModeratelyLowSpeedEndLevel. </p>
       <p>Mainly used with combustion engines to prevent rotation of engine in wrong direction. </p>
       <p>This will be combined with no allowed current in wrong direction to get a
       continous allowed current curve. </p>
       <p>Rotational direction must be correctly defined using Inverted Rotational Direction in
       <a href="#ApplicationSetupParameters.ApplicationSetupWord">ApplicationSetupWord</a>. </p>
       <p>Setting the parameter to 0 disables the function. </p>
       
      ]]></Description></Parameter><Parameter SymbolName="ModeratelyLowSpeedEndLevel" Index="0x2095" SubIndex="14" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       See ModeratelyLowSpeedStartLevel.
       
      ]]></Description></Parameter><Parameter SymbolName="AccCurrentLimit" Index="0x2095" SubIndex="15" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Sets accelerating current limit. <br/>
       Used for external (CAN) limitation. <br/>
       Available acceleration current is always the minimum of the AbilityAccelerationCurrent (2095h:9) and AccCurrentLimit.
       
      ]]></Description></Parameter><Parameter SymbolName="BrakeCurrentLimit" Index="0x2095" SubIndex="16" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Sets braking Current limit. <br/>
       Used for external (CAN) limitation. <br/>
       Available brake current is always the minimum of the AbilityBrakeCurrent (2095h:10) and BrakeCurrentLimit.
       
      ]]></Description></Parameter><Parameter SymbolName="ActualLimitationType" Index="0x2095" SubIndex="19" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="15" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Type of (reason for) actual limitation.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="No limitation"/>
        <ValueFieldDef Value="1" Description="Event limitation"/>
        <ValueFieldDef Value="2" Description="Motor temperature limitation"/>
        <ValueFieldDef Value="3" Description="Low DC voltage limitation"/>
        <ValueFieldDef Value="4" Description="High DC voltage limitation"/>
        <ValueFieldDef Value="5" Description="Low speed limitation"/>
        <ValueFieldDef Value="6" Description="High speed limitation"/>
        <ValueFieldDef Value="7" Description="Dc current limitation"/>
        <ValueFieldDef Value="8" Description="Dc power limitation"/>
        <ValueFieldDef Value="9" Description="External current limitation"/>
        <ValueFieldDef Value="10" Description="External torque limitation"/>
        <ValueFieldDef Value="11" Description="Heatsink temperature limitation"/>
        <ValueFieldDef Value="12" Description="Energy limitation"/>
        <ValueFieldDef Value="13" Description="Max current limitation"/>
        <ValueFieldDef Value="14" Description="Max voltage angle limitation"/>
        <ValueFieldDef Value="15" Description="Switching frequency limitation"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="AccLimitationType" Index="0x2095" SubIndex="20" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="15" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Rreason for the lowest (most limiting) accelerating current limit. If an actual limitation of the acceleration current
        takes place then the value of <a href="#CurrentLimit.ActualLimitationType">ActualLimitationType</a>
        will be the same as this value.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="No limitation"/>
        <ValueFieldDef Value="1" Description="Event limitation"/>
        <ValueFieldDef Value="2" Description="Motor temperature limitation"/>
        <ValueFieldDef Value="3" Description="Low DC voltage limitation"/>
        <ValueFieldDef Value="4" Description="High DC voltage limitation"/>
        <ValueFieldDef Value="5" Description="Low speed limitation"/>
        <ValueFieldDef Value="6" Description="High speed limitation"/>
        <ValueFieldDef Value="7" Description="Dc current limitation"/>
        <ValueFieldDef Value="8" Description="Dc power limitation"/>
        <ValueFieldDef Value="9" Description="External current limitation"/>
        <ValueFieldDef Value="10" Description="External torque limitation"/>
        <ValueFieldDef Value="11" Description="Heatsink temperature limitation"/>
        <ValueFieldDef Value="12" Description="Energy limitation"/>
        <ValueFieldDef Value="13" Description="Max current limitation"/>
        <ValueFieldDef Value="15" Description="Switching frequency limitation"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="BrakeLimitationType" Index="0x2095" SubIndex="21" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="15" DefaultValue="-" Factor="1" Unit="-"><Description><![CDATA[
       
        Reason for the lowest (most limiting) brake current limit. If an actual limitation of the brake current
        takes place then the value of <a href="#CurrentLimit.ActualLimitationType">ActualLimitationType</a>
        will be the same as this value.
       
      ]]></Description><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="No limitation"/>
        <ValueFieldDef Value="1" Description="Event limitation"/>
        <ValueFieldDef Value="2" Description="Motor temperature limitation"/>
        <ValueFieldDef Value="3" Description="Low DC voltage limitation"/>
        <ValueFieldDef Value="4" Description="High DC voltage limitation"/>
        <ValueFieldDef Value="5" Description="Low speed limitation"/>
        <ValueFieldDef Value="6" Description="High speed limitation"/>
        <ValueFieldDef Value="7" Description="Dc current limitation"/>
        <ValueFieldDef Value="8" Description="Dc power limitation"/>
        <ValueFieldDef Value="9" Description="External current limitation"/>
        <ValueFieldDef Value="10" Description="External torque limitation"/>
        <ValueFieldDef Value="11" Description="Heatsink temperature limitation"/>
        <ValueFieldDef Value="12" Description="Energy limitation"/>
        <ValueFieldDef Value="13" Description="Max current limitation"/>
        <ValueFieldDef Value="15" Description="Switching frequency limitation"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="LimitPosCurrent" Index="0x2095" SubIndex="22" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Show the limitited current in positive direction. <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="LimitNegCurrent" Index="0x2095" SubIndex="23" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="0" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Show the limitited current in negative direction. <br/>
       
      ]]></Description></Parameter><Parameter SymbolName="MaxIncTorqueChange" Index="0x2095" SubIndex="24" ObjectType="VAR" DataType="INTEGER32" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1000000" Factor="1" Unit="Nm/s"><Description><![CDATA[
       
       Slew rate limitation for increasing torque.<br/>
       Increasing torque is defined as when the absolute value of the torque increases.<br/>
       Set to 0 to disable function. Both increasing and decreasing limitation will be disabled.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxDecTorqueChange" Index="0x2095" SubIndex="25" ObjectType="VAR" DataType="INTEGER32" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1000000" Factor="1" Unit="Nm/s"><Description><![CDATA[
       
       Slew rate limitation for decreasing torque.<br/>
       Decreasing torque is defined as when the absolute value of the torque decreases.<br/>
       Set to 0 to disable function. Both increasing and decreasing limitation will be disabled.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxTorqueChangeAtLowTorque" Index="0x2095" SubIndex="26" ObjectType="VAR" DataType="INTEGER32" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1000000" Factor="1" Unit="Nm/s"><Description><![CDATA[
       
       Slew rate limitation at low torque.<br/>
       Low torque is defined as below LowTorqueLevel.<br/>
       Set to 0 to disable function.
       
      ]]></Description></Parameter><Parameter SymbolName="LowTorqueLevel" Index="0x2095" SubIndex="27" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="4335" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
       Below this level, low torque slew rate limitation will be active.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt1kHz" Index="0x2095" SubIndex="30" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 1 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt2kHz" Index="0x2095" SubIndex="31" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 2 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt4kHz" Index="0x2095" SubIndex="32" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 4 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt6kHz" Index="0x2095" SubIndex="33" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 6 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt8kHz" Index="0x2095" SubIndex="34" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 8 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt12kHz" Index="0x2095" SubIndex="35" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 12 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt16kHz" Index="0x2095" SubIndex="36" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 16 kHz.
       
      ]]></Description></Parameter><Parameter SymbolName="MaxCurrentAt20kHz" Index="0x2095" SubIndex="37" ObjectType="VAR" DataType="INTEGER16" Visibility="Internal" AccessType="rw" MinimumValue="0" MaximumValue="2316" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Max allowed current when switching frequency is 20 kHz.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="SpeedRegulatorInternalVariables"><Parameter SymbolName="LastSubIndex" Index="0x2096" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="InternalSpeedReference" Index="0x2096" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Speed reference input to speed PI controller (internal SW variable).
       Differs from Command Speed when ramps and/or BPC are used.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentReference" Index="0x2096" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Reference Current From Speed PI-controller.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedRegIPart" Index="0x2096" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Speed regulator I part.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedRegDPart" Index="0x2096" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
       Speed regulator D part.
       
      ]]></Description></Parameter><Parameter SymbolName="SpeedRegDPartFilterFactor" Index="0x2096" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="16384" DefaultValue="1600" Factor="1"><Description><![CDATA[
       
        Filter constant used for high pass filter in D-regulator.
        A lower value results in lower cut-off frequency.
       
      ]]></Description></Parameter><Parameter SymbolName="PGainUsed" Index="0x2096" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
       Speed regulator P-gain actually used.
       
      ]]></Description></Parameter><Parameter SymbolName="IGainUsed" Index="0x2096" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
       Speed regulator I-gain actually used.
       
      ]]></Description></Parameter><Parameter SymbolName="DGainUsed" Index="0x2096" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
       Speed regulator D-gain actually used.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="CurrentBoost" WarningRemark="Internal Use Only"><Parameter SymbolName="LastSubIndex" Index="0x2097" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentBoostTimeToStart" Index="0x2097" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1500" Factor="1" Unit="see Description"><Description><![CDATA[
       
       The Current has to be saturated in max limit for a time greater than
       this limit in order for automatic boost to start. <br/>
       Automatic boost will be disabled if this limit is set to Zero. <br/> <br/>
       Unit: 500 = 1 sec
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentBoostTime" Index="0x2097" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1500" Factor="1" Unit="see Description"><Description><![CDATA[
       
       Duration of Current Boost. Max value is 3 seconds. <br/><br/>
       Unit: 500 = 1 sec
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentBoostFactor" Index="0x2097" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="1229" Factor="1" Unit="see Description"><Description><![CDATA[
       
       The Current Boost can be 20% higher than maximum drive current,
       i.e. max value is 120%.
       MaxAccCurrent = Factor/1024 * AbilityCurrent (0x2095:9-10) or CurrentLimit (0x2095:15-16)
       1024 = 100%
       The factor is temperature dependant which means that maximum is reduced
       linearly from 120% to 100% when temperature climbs from 60 to 85 degrees.
       
      ]]></Description></Parameter><Parameter SymbolName="CurrentBoostSpeedLimit" Index="0x2097" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Actual speed need to be less than this limit at the same time as the Commnade speed
       is above this limit for a period longer than CurrentBoostTimeToStart in order
       for the automatic boost to start.
       
      ]]></Description></Parameter></Group>

<Group SymbolName="SpeedRamp"><Parameter SymbolName="LastSubIndex" Index="0x2098" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="RampState" Index="0x2098" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="9" DefaultValue="-" Factor="1" Unit="-" WarningRemark="Internal Use Only"><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="Accelerate"/>
        <ValueFieldDef Value="1" Description="Decelerate Coast"/>
        <ValueFieldDef Value="2" Description="Decelerate Adjust"/>
        <ValueFieldDef Value="3" Description="Decelerate No Adjust"/>
        <ValueFieldDef Value="4" Description="Hold"/>
        <ValueFieldDef Value="5" Description="Push"/>
        <ValueFieldDef Value="6" Description="Close To Stand"/>
        <ValueFieldDef Value="7" Description="Stand"/>
        <ValueFieldDef Value="8" Description="Rollback"/>
        <ValueFieldDef Value="9" Description="Speed Decelerate Anti Clonk State"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="SpeedChangeFactor" Index="0x2098" SubIndex="2" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="100" Factor="1" Unit="see Description"><Description><![CDATA[
       
       Parameters <a href="#ApplicationCommands">ApplicationCommands, CommandAccelerationChange/CommandDecelerationChange</a> will be divided by the value of this parameter. <br/><br/>
       Only used in Speed Control Modes with ramps (<a href="#ApplicationSetupParameters">ApplicationSetupParameters, SpeedRampMode</a> = 4 or 5). <br/><br/>
       E.g., a SpeedChangeFactor value equal to 10 will have the following effect on the unit of CommandAccelerationChange/CommandDecelerationChange:<br/>
         <UL>
           <LI> (rpm/2ms) / 10 => rpm/20ms
         </UL>
       
      ]]></Description></Parameter><Parameter SymbolName="AntiClonkNumberOfCounts" Index="0x2098" SubIndex="3" ObjectType="VAR" DataType="UNSIGNED16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="65535" Factor="1" Unit="no"><Description><![CDATA[
       
       Used to adjust Command Speed Ramped to Actual Speed via a ramp within
       Anti Clonk Number Of Counts (each count is 2 ms). This function is used
       together with MaxCurrentChange so that the "clonk" in the gear becomes
       ok. Anti Clonk Number Of Counts = 0 disables the function. Only used in
       Speed Control Modes with ramps (<a href="#ApplicationSetupParameters">ApplicationSetupParameters, SpeedRampMode</a> = 4 or 5). <br/><br/>
       The deceleration in rpm/2ms becomes equal to
       (ActualSpeed-CommandSpeedRamped)  / AntiClonkNumberOfCounts <br/><br/>
       during AntiClonkNumberOfCounts*2ms if the Actual Speed decreases below
       Command Speed Ramped (only executed once per deceleration phase).
       
      ]]></Description></Parameter><Parameter SymbolName="AntiClonkDeltaSpeedLimit" Index="0x2098" SubIndex="4" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Used when Bit 1 Adjust Speed During Deceleration in <a href="#ApplicationSetupParameters">ApplicationSetupParameters, ApplicationSetupWord</a>
       is NOT set. Anti Clonk algorithm is then activated when
       CommandSpeedRamped &lt; ABS(ActualSpeed+ AntiClonkDeltaSpeedLimit). <br/><br/>
       In order to not use this feature set Anti Clonk Delta Speed Limit equal
       to <a href="#ApplicationSetupParameters">ApplicationSetupParameters, MaxCommandSpeed</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="AntiClonkCommandSpeedLimit" Index="0x2098" SubIndex="5" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Anti Clonk algorithm is acivated if ABS(CommandSpeed) &lt; AntiClonkCommandSpeedLimit. <br/><br/>
       Used to disable Anti Clonk Algorithm at high speeds. In order to not use this
       feature set Anti Clonk Command Speed Limit equal to <a href="#ApplicationSetupParameters">ApplicationSetupParameters, MaxCommandSpeed</a>.
       
      ]]></Description></Parameter><Parameter SymbolName="ReverseBrakeMaxSpeedInRpm" Index="0x2098" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
       Define maximum speed in reverse direction to be applied when <a href="#ApplicationSetupParameters">ApplicationSetupParameters, SpeedRampMode</a> = 5 is selected.
       
      ]]></Description></Parameter><Parameter SymbolName="RampedRollBackSpeed" Index="0x2098" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="32767" DefaultValue="-" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Ramped rollback speed parameter (see also <a href="#ApplicationSetupParameters">ApplicationSetupParameters, RollBackSpeed</a>).
       
      ]]></Description></Parameter><Parameter SymbolName="PushSpeedLimit" Index="0x2098" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-32768" MaximumValue="32767" Factor="1" Unit="Rpm"><Description><![CDATA[
       
        Below the PushSpeedLimit the integral part in the speed controller is not
        allowed to build up. <br/>
        If this parameter is set to Zero there will be no speed limitation for
        allowing the integral part to increase. <br/><br/>
        Use case 1: <br/>
        A "push" problem is when a vehicle is stuck going forward but also have
        forward torque buildup due to integration. Then when the hindrance is
        suddenly removed there will be a jump in speed. The same problem exists
        in both directions. <br/><br/>
        In order to avoid the "push" problem it is recommended to set PushSpeedLimit
        to "some low speed". Recommended value is 10 rpm. <br/><br/>
        Use case 2: <br/>
        An "uphill rolling back" problem may occur when a vehicle (e.g. golf cart)
        is stopped uphill and the driver does not apply enough acceleration to
        circumvent the slope. Then the vehicle may start rolling backward. <br/> <br/>
        In order to avoid the "uphill rolling back" problem it is recommended to set
        PushSpeedLimit to Zero. This, to mimic an automatic gear box that does not
        allow negative movement when drive gear is engaged (positive movement).
       
      ]]></Description></Parameter><Parameter SymbolName="IGainMode" Index="0x2098" SubIndex="9" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="5" DefaultValue="-" Factor="1" Unit="-" WarningRemark="Internal Use Only"><ValueFieldDefs>
        <ValueFieldDef Value="0" Description="SPEED_IREG_OFF_MODE"/>
        <ValueFieldDef Value="1" Description="SPEED_IREG_NORMAL_MODE"/>
        <ValueFieldDef Value="2" Description="SPEED_IREG_INCREASE_MODE"/>
        <ValueFieldDef Value="3" Description="SPEED_IREG_ROLLBACK_MODE"/>
        <ValueFieldDef Value="4" Description="SPEED_IREG_TO_ZERO_MODE"/>
        <ValueFieldDef Value="5" Description="SPEED_IREG_DECELERATE_MODE"/>
      </ValueFieldDefs></Parameter><Parameter SymbolName="IregAccelerationLimit" Index="0x2098" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="32767" DefaultValue="0" Factor="1" Unit="Rpm/20ms"><Description><![CDATA[
       
        Above this acceleration level the integral part in the speed controller
        is not allowed to build up.
       
      ]]></Description></Parameter><Parameter SymbolName="ForcePumpBehavior" Index="0x2098" SubIndex="11" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="1" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Force PUMP motor specific integral control behavior in speed controller even when <a href="#DeviceType">DeviceType</a> is not PUMP.
        This prevents integral build-up in the wrong direction in order to avoid undershoot (pump spinning backwards) when stopping the motor.
        Only possible to activate in speed control without ramps, <a href="#ApplicationSetupParameters">ApplicationSetupParameters.SpeedRampMode</a> = 1,
        and not using Steer Wheel Mode or Tiller Mode in <a href="#ApplicationSetupParameters.RequestedControlMode">ApplicationSetupParameters.RequestedControlMode</a>.
       
      ]]></Description><ValueFieldDefs>
       <ValueFieldDef Value="0" Description="Default: Evaluate regulator behavior based on hardware ID configuration."/>
       <ValueFieldDef Value="1" Description="Force PUMP motor regulator behavior."/>
      </ValueFieldDefs></Parameter></Group>

<Group SymbolName="TorqueToCurrentCalculation"><Parameter SymbolName="LastSubIndex" Index="0x2099" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="CommandCurrentFromCommand" Index="0x2099" SubIndex="1" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-32768" MaximumValue="32767" DefaultValue="-" Factor="1"><Description><![CDATA[
       
        Command current that is recalculated from command torque.
       
      ]]></Description></Parameter><Parameter SymbolName="AccCurrentLimitFromAccTorqueLimit" Index="0x2099" SubIndex="2" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Command acceleration current limit that is recalculated from acceleration
        command limit torque.
       
      ]]></Description></Parameter><Parameter SymbolName="BrakeCurrentLimitFromBrakeTorqueLimit" Index="0x2099" SubIndex="3" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Command brake current limit that is recalculated from brake
        command limit torque.
       
      ]]></Description></Parameter><Parameter SymbolName="AccTorqueLimit" Index="0x2099" SubIndex="6" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        The acc torque limit from CAN.
       
      ]]></Description></Parameter><Parameter SymbolName="BrakeTorqueLimit" Index="0x2099" SubIndex="7" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        The brake torque limit from CAN.
       
      ]]></Description></Parameter><Parameter SymbolName="MissingCommandTorque" Index="0x2099" SubIndex="8" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        The torque that has to be addded to command torque to actually
        get the commanded torque.
       
      ]]></Description></Parameter><Parameter SymbolName="MissingAccTorqueLimit" Index="0x2099" SubIndex="9" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        The acc torque limit torque that has to be addded to acc torque limit to actually
        get the acc torque limit.
       
      ]]></Description></Parameter><Parameter SymbolName="MissingBrakeTorqueLimit" Index="0x2099" SubIndex="10" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-4335" MaximumValue="4335" DefaultValue="-" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        The brake torque limit torque that has to be addded to brake torque limit to actually
        get the brake torque limit.
       
      ]]></Description></Parameter><Parameter SymbolName="TorqueToCurrentConversionFactor" Index="0x2099" SubIndex="11" ObjectType="VAR" DataType="INTEGER32" Visibility="Operator" AccessType="rw" MinimumValue="0" MaximumValue="2147483647" Factor="1" Unit="Arms/Nm * 1024"><Description><![CDATA[
       
       Factor used for initial convertion of torque to current. It must be
       approximately correct for torque control and limits to work.
       
      ]]></Description></Parameter><Parameter SymbolName="FeedForwardTorque" Index="0x2099" SubIndex="12" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="rw" MinimumValue="-4335" MaximumValue="4335" DefaultValue="0" Factor="0.1" Unit="Nm"><Description><![CDATA[
       
        Feed forward torque that will be recalculated to current.
       
      ]]></Description></Parameter><Parameter SymbolName="FeedForwardCurrent" Index="0x2099" SubIndex="13" ObjectType="VAR" DataType="INTEGER16" Visibility="Operator" AccessType="ro" MinimumValue="-2317" MaximumValue="2316" DefaultValue="-" Factor="1" Unit="Arms"><Description><![CDATA[
       
        Feed forward current that is recalculated from torque feed forward.
       
      ]]></Description></Parameter></Group>

