<Group SymbolName="TransmitPDO4ComParameters"><Parameter SymbolName="LastSubIndex" Index="0x1803" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
        Numbers of entries.
       
      ]]></Description></Parameter><Parameter SymbolName="CobIdPDOTx" Index="0x1803" SubIndex="1" ObjectType="VAR" DataType="UNSIGNED32" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="4294967295" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
