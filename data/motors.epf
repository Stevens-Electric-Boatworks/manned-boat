<Group SymbolName="MemoryAccessBank3"><Parameter SymbolName="LastSubIndex" Index="0x2253" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="Operator" AccessType="ro" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
