      <Group Name="Main:Motor Temperature Sensor">
        <Event Name="NotConnected" EventId="600u" CheckIn4Khz="FALSE" StoreInLog="TRUE" StoreFreezeFrame="FALSE">
   <Description><![CDATA[
    
    <b>Description</b><br/>
     Event is set if motor temperature sensor is not connected.<br/>
     SW algorithm: Temperature measurement is out of range.<br/>
     Limits: Event is set when sensor measures 210 deg celsius<br/>
     <i>Note:</i> If the resistance decreases with increasing temperature, such
     as for an NTC sensor, this event signals a short-circuit instead.<br/>
     <b>When is event evaluated</b><br/>
     Always<br/>
     <b>Related parameters</b><br/>
     <a href="#MotorTemperature">MotorTemperature, Temperature</a><br/>
    
   ]]></Description>
   <EmcyCode Value="0x4220u"/>
   <DtcCode Value="0x7E0321Fu"/>
     <ReductionFactor Value="50"/>
   <ErrorBit Value="31u"/>
   <WarningBit Value="NO_WARNING_BIT"/>
     <PumpSystemReaction Value="NO_SYSTEMREACTIONS_BIT"/>
