<Group SymbolName="TransmitPDO4MapParameters"><Parameter SymbolName="NumberOfObjects" Index="0x1A03" SubIndex="0" ObjectType="VAR" DataType="UNSIGNED8" Visibility="OEM" AccessType="rw" MinimumValue="0" MaximumValue="255" DefaultValue="0" Factor="1" Unit="-"><Description><![CDATA[
       
